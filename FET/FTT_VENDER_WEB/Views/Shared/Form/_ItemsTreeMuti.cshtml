@model ItemTreeMultiVO
@{
    Layout = null;
    // 多選的報修項目樹
    // [/CI/node_menu.aspx]ReqSource=ALL&TreeCategory=CI&SelectConstrain=LEAVE&SelectedMode=MULTIPLE(多選)
    var mapData = new
    {
        IdModal = Model.Id,
        IdTree = Guid.NewGuid().ToString("N"),
        // 內部選取結果
        IdModalSelectedPool = Guid.NewGuid().ToString("N"),
        IdBtnOk = Guid.NewGuid().ToString("N"),
        UrlGetListTreeChildren = $"{config.GetBackendUrl()}/Api/GetListTreeChildrenCi",
        UrlGetListTreeItem = $"{config.GetBackendUrl()}/Api/GetListTreeItemCi",
        // 表單選取結果顯示
        IdSelectedPool = Guid.NewGuid().ToString("N"),
        // 表單選取結果
        IdSelect = Guid.NewGuid().ToString("N"),
    };
}

<div id="@mapData.IdSelectedPool" class="partialDisplayPool" data-bs-toggle="modal" data-bs-target="#@(mapData.IdModal)"></div>
@if (!string.IsNullOrEmpty(Model.PropertyName))
{
    <select id="@(mapData.IdSelect)" name="@(Model.PropertyName)[]" multiple class="form-select d-none"></select>
}
else
{
    <select id="@(mapData.IdSelect)" multiple class="form-select d-none"></select>
}

<div class="modal fade max100vh" id="@(mapData.IdModal)" tabindex="-1" role="dialog" aria-labelledby="@(mapData.IdModal)" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header text-center">
                <h5 class="modal-title w-100 text-center">報修品項</h5>
                <button class="btn-close" type="button" aria-label="Close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="@(mapData.IdModalSelectedPool)" class="partialSelectedPool mb-3"></div>
                <div id="@(mapData.IdTree)" class="partialSelectTree"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" type="button" id="@(mapData.IdBtnOk)">確認</button>
            </div>
        </div>
    </div>
</div>

<script>
    var context = context || {};
    $(function () {
        if (!context['@(mapData.IdModal)']) {
            context['@(mapData.IdModal)'] = {};
        }

        var ctxModal = context['@(mapData.IdModal)'];
        ctxModal.$Modal = $('#@(mapData.IdModal)');
        // 是否必填
        ctxModal.required = ctxModal.required || false;
        // 是否已顯示
        ctxModal.firstShow = false;
        ctxModal.result = '';
        // 選擇的 id
        ctxModal.selected = ctxModal.selected || [];
        ctxModal.selectedItem = [];
        // 根節點
        ctxModal.rootNode = {
            id: "1006",
            text: "報修品項",
            children: true,     // 告訴 jsTree：此節點有子節點，展開時會觸發 AJAX
            state: { opened: false }, // 一開始不打 API，等我們手動展開
            a_attr: { class: 'no-checkbox' },
        };

        ctxModal.$SelectedPool = $('#@(mapData.IdSelectedPool)');
        ctxModal.$ModalSelectedPool = $('#@(mapData.IdModalSelectedPool)');

        ctxModal.Tree = {
            // 暫存的選擇 id
            selected: [],
            // 暫存的選擇項目
            selectedItem: [],
            // tree 是否已 ready
            _isTreeReady: false,
            // 暫存 setValue 在 tree 未 ready 前的值
            _pendingSetValue: null,
            // jsTree 實例
            instance: null,
        };
        ctxModal.$Tree = $('#@(mapData.IdTree)');
        ctxModal.$Tree.jstree({
                force_text:true,
            themes: {
                icons: false
            },
            core: {
                data: function (obj, cb) {
                    // 第一次初始化時，obj.id 為 "#"
                    if (obj.id === "#") {
                        // 回傳 root
                        cb([ctxModal.rootNode]);
                        return;
                    }

                    // 其餘情況：展開節點時 jsTree 會帶入該 node.id
                    $.ajax({
                        url: '@(mapData.UrlGetListTreeChildren?.ToHtmlString())',
                        data: { parentId: obj.id },
                        type: 'POST',
                        dataType: 'json'
                    }).done(function (response) {
                        if (response.Success) {
                            let data = response.Data || [];
                            $.each(data, function (index, value) {
                                value['a_attr'] = { class: 'no-checkbox' };
                            });
                            cb(data);
                        }
                        else {
                            MyApp.Alert.error(response['Message']);
                            cb([]);
                        }
                    }).fail((err) => {
                        console.log(err);
                        cb([]);
                    });
                },
                multiple: true,
            },
            plugins: ['themes', 'checkbox'],
            checkbox: {
                three_state: false,  // 不要自動勾選父節點
                cascade: '',           // 不連動子節點勾選
                keep_selected_style: true,
            },
        });
        ctxModal.$Tree.on('ready.jstree', function (e, data) {
            let instance = data.instance;
            ctxModal.Tree._isTreeReady = true;

            if (!instance.is_open(ctxModal.rootNode.id)) {
                // 展開根節點
                instance.open_node(ctxModal.rootNode.id);
            }

            if (ctxModal.Tree._pendingSetValue) {
                ctxModal.setValue(ctxModal.Tree._pendingSetValue);
                ctxModal.Tree._pendingSetValue = null;
            }
        });
        ctxModal.$Tree.on('changed.jstree', function (e, data) {
            let instance = data.instance;
            // 當前選擇的 node
            let nodeCurrent = data.node;
            // 選擇的 id 陣列
            let selectedNodes = data.selected;

            if (!instance.is_leaf(nodeCurrent)) {
                instance.deselect_node(nodeCurrent.id);
            }
            else {
                let selectedDatas = $.map(selectedNodes, function (value, index) {
                    return instance.get_node(value);
                });
                ctxModal.ModalSelectedPool.init(selectedDatas);
            }
        });
        ctxModal.Tree.instance = ctxModal.$Tree.jstree(true);

    ctxModal.ModalSelectedPool = {};
    ctxModal.ModalSelectedPool.init = function (selectedDatas) {
        const control = ctxModal.$ModalSelectedPool;
        control.innerHTML = ""; // 清空

        ctxModal.Tree.selected = [];
        ctxModal.Tree.selectedItem = [];

        selectedDatas.forEach(value => {
            // 建立 span
            const span = document.createElement("span");
            span.className = "partialTag";
            span.textContent = value.text ?? "";

            // 建立刪除按鈕
            const btnDelete = document.createElement("button");
            btnDelete.type = "button";
            btnDelete.className = "partialRemove";
            btnDelete.textContent = "x";

            btnDelete.addEventListener("click", () => {
                ctxModal.Tree.instance.deselect_node(value.id);
            });

            // 安全地加入 span
            span.appendChild(btnDelete);
            control.appendChild(span);

            // 更新選取陣列
            ctxModal.Tree.selected.push(value.id);
            ctxModal.Tree.selectedItem.push(value);
        });
    }


        ctxModal.$Select = $('#@(mapData.IdSelect)');
        ctxModal.Select = {};
        ctxModal.Select.init = function (dataSource, value) {
            value = value || [];

            let $control = ctxModal.$Select;
            $control.empty();
            $control.select2({
                data: dataSource,
            });
            $control.next('.select2-container').hide();

            $control.val(value);
        };

        $('#@(mapData.IdBtnOk)').on('click', function () {
            if (ctxModal.firstShow === true && ctxModal.required === true) {
                if (ctxModal.Tree.selected.length === 0) {
                    MyApp.Alert.warning('請選擇一個品項');
                    return;
                }
            }

            ctxModal.selected = ctxModal.Tree.selected;
            ctxModal.selectedItem = ctxModal.Tree.selectedItem;

            ctxModal.$SelectedPool.empty();
            ctxModal.$SelectedPool.html(ctxModal.$ModalSelectedPool.html());
            ctxModal.$SelectedPool.find('.partialRemove').remove();

            ctxModal.Select.init($.map(ctxModal.selected, function (value, index) {
                return {
                    id: value,
                    text: value,
                };
            }), ctxModal.selected);

            ctxModal.result = '1';
            $('#@mapData.IdModal').modal('hide');
        });

        ctxModal.$Modal.on('show.bs.modal', async function () {
            ctxModal.firstShow = true;
        });

        ctxModal.setValue = async function (value) {
            value = value || [];

            if (!ctxModal.Tree._isTreeReady) {
                ctxModal.Tree._pendingSetValue = value;
                return;
            }

            if (value.length) {
                try {
                    let response = await $.ajax({
                        url: '@(mapData.UrlGetListTreeItem?.ToHtmlString())',
                        data: { idList: value },
                        type: 'POST',
                        dataType: 'json'
                    });

                    if (response.Success === true) {
                        let data = response.Data || [];
                        let setPathId = new Set();
                        // 因為可能執行此段時，根節點尚未展開，所以加上根節點
                        setPathId.add(ctxModal.rootNode.id);
                        $.each(data, function (index, value) {
                            let pathCsv = value['@(nameof(Core.Utility.Web.EX.TreeJsFlatModel.OtherAttr))']['PathCsv'] || '';
                            $.each(pathCsv.split(','), function (index2, value2) {
                                setPathId.add(value2);
                            });
                        });

                        expandTree('@(mapData.IdTree)', Array.from(setPathId), function () {
                            // 等展開完成後再選取
                            value.forEach(id => {
                                ctxModal.Tree.instance.select_node(id);
                            });
                            $('#@(mapData.IdBtnOk)').trigger('click');
                        });
                    }
                    else {
                        MyApp.Alert.error(response.Message);
                    }
                } catch (e) {
                    console.log(e);
                }
            }
        };
    });
</script>
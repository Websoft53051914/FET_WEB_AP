@using FTT_VENDER_WEB.Common
@{
    var show = true;
    var isShowLayout = ViewData["IsShowLayout"];

    if (isShowLayout != null && isShowLayout.ToString().ToLower() == "false")
    {
        show = false;
    }

    var mapText = new
    {
        Btn_Confirm = "確認",
    };

}
@functions {
    protected string GetUserLoginName()
    {
        return LoginSession.Current.engname;
    }
}

<style>
    @@media screen and (max-width: 500px) {
        .hide500 {
            display: none !important;
        }
    }
    .nav-menus {
        padding: 5px 10px !important;
        flex-wrap: wrap !important;
        height: auto !important;
    }
</style>
@if (show)
{
    <div class="page-main-header">
        <div class="main-header-right row m-0">

            <div class="main-header-left">
                <div class="logo-wrapper">
                    <a href="@Url.Action("Index","Home")" data-bs-original-title="" title="">
                        <img class="img-fluid" src="~/lib/login/image/fet_log_new.png" alt="" style="max-width:130px">
                    </a>
                </div>
                <div class="dark-logo-wrapper"><a href="index" data-bs-original-title="" title=""><img class="img-fluid" src="~/lib/login/image/fet_log_new.png" alt=""></a></div>
                <div class="toggle-sidebar"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-align-center status_toggle middle" id="sidebar-toggle"><line x1="18" y1="10" x2="6" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="18" y1="18" x2="6" y2="18"></line></svg></div>
            </div>
            <div class="nav-right col pull-right right-menu p-0">
                <ul class="nav-menus" style="padding: 0px 10px;">
                    <li>
                        <i class="fa fa-user-circle-o me-1" aria-hidden="true" style="font-size:16px"></i>
                        <label id="userloginname"></label>
                    </li>
                    <li class="onhover-dropdown p-0">
                        <button class="btn btn-primary-light" style="min-width: 100px;" id="btn-logout">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-log-out">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>登出
                        </button>
                    </li>
                    <li class="align-items-center hide500" style="display:flex;white-space:nowrap;">
                        <a role="button" style="color:var(--main_color)" href="/download/FAQ_20250311.doc" download="FAQ.doc">問與答FAQ</a>
                    </li>
                </ul>
            </div>
            <div class="d-lg-none mobile-toggle pull-right w-auto">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-more-horizontal">
                    <circle cx="12" cy="12" r="1">
                    </circle>
                    <circle cx="19" cy="12" r="1">
                    </circle>
                    <circle cx="5" cy="12" r="1">
                    </circle>
                </svg>
            </div>
        </div>
    </div>
}
<script src="~/lib/jsCookie/js.cookie.min.js"></script>
<script>
    $(document).ready(function () {
        $('#userloginname').text(decodeURIComponent(Cookies.get('userLoginName')))
        $('#btn-logout').on('click', function () {
            showLoader();
            // var data = { formNo: formNo };
            $.ajax({
                type: 'post',
                url: '@(config.GetBackendUrl() + Url.Action("Logout", "Logout"))',
                headers: {
                    'Content-from': 'Logout'
                },
                // data: data,
                dataType: 'json',
                success: function (data) {
                    if (data.Success == true) {
                        hideLoader();
                        window.location.href = '@Url.Action("Index", "Login")';


                    } else {
                        alert(data.Message);
                        hideLoader();
                    }
                },
                error: function (data) {
                    hideLoader();
                }
            });
        })
    });
</script>
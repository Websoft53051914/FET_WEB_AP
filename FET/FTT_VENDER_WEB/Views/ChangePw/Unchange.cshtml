@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    @*<meta name="viewport" content="width=1280" />*@
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="format-detection" content="telephone=no">
    <link rel="shortcut icon" href="~/favicon.ico" />
    <title>FET Login</title>

    <link rel="stylesheet" href="~/lib/viho/assets/css/bootstrap.css" />
    <link rel="stylesheet" href="~/lib/viho/assets/css/fontawesome.css" />
    <link rel="stylesheet" type="text/css" href="~/lib/viho/assets/css/sweetalert2.css">


    <style>
        html {
            background-color: transparent;
            background-image: url("@Url.Content("~/lib/login/image/login_image.png")");
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center center;
            background-attachment: fixed;
        }

        html {
            position: relative;
            min-height: 100%;
            background-color: #f4f4f4;
            font-family: Verdana, sans-serif;
            font-size: 16px;
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: transparent;
            font-family: Verdana, sans-serif;
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
        }

        .login-view .logo {
            width: 180px;
            -webkit-user-drag: none;
        }

        .login-view .form-mask {
            background-color: white;
            border-radius: 10px;
            border: solid 1px #e6e6e6;
            padding: 30px 60px;
        }

        .login-view th, td {
            text-align: center;
            vertical-align: middle;
        }

        .login-view thead {
            border-bottom: solid #808080;
        }

        #PdEye {
            width: 20px;
        }

        .login-view .login-table {
            max-width: 600px;
        }

        .login-view .login-info {
            max-width: 800px;
        }

        .btn-confirm {
            color: #fff;
            background: #666;
            border-color: transparent;
        }
    </style>


</head>
<body>

    <div class="login-view container-fluid">
        <div class="row justify-content-center">
            <div class="login-table col-12 col-sm-10 col-md-8 mt-sm-3 p-0 d-flex justify-content-center">
                <div class="form-mask row  w-100">
                    <form id="LoginForm" method="post">
                        <div class="mb-3 d-flex flex-column align-items-center">
                            <img class="logo" src="~/lib/login/image/fet_log_new.png" />
                            <span class="display-6 text-center fw-bold">Facilities T.T</span>
                        </div>

                        <hr />
                        <div class="mt-5" style="text-align: center;">
                            <h1>驗證碼已失效</h1>
                        </div>

                        <div class="mt-4 text-center">
                            <a href="/" class="btn btn-confirm px-4 py-2">返回首頁</a>
                        </div>

                        <br />
                        <br />

                        <div class="d-flex justify-content-center">
                            <span class="fs-3 text-nowrap"><b>請使用[<a href="javascript:void(0)">Chrome</a>]瀏覽器開啟 !!</b></span>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>

    <script src="~/lib/viho/assets/js/jquery-3.5.1.min.js"></script>
    <script src="~/lib/viho/assets/js/sweet-alert/sweetalert.min.js"></script>
    <script src="~/js/handlebars.min-v4.7.7.js"></script>

    <script>
        var captchaId = "";

        changeCaptcha(document.getElementById('imgCaptcha'));

        document.getElementById('imgCaptcha').addEventListener('click', function () {
            let $errorMsg = $('#errorMsg');
            var img = this;
            changeCaptcha(img);
        });

        const $Loder = $('#loader-mask');

        async function changeCaptcha(img) {
            let $errorMsg = $('#errorMsg');
            $.ajax({
                url: '@(config.GetBackendUrl() + Url.Action("GetCaptcha", "ChangePw"))',
                type: 'post',
                xhrFields: {
                    withCredentials: true // ← 這個讓瀏覽器攜帶 Cookie
                },
                headers: {
                    "Content-From": "GetCaptcha",
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': await fetchCsrfToken()
                },
                credentials: 'include',
                success: function (data) {

                    if (data.Success) {
                        img.src = data.Data.imageBase64;
                        captchaId = data.Data.captchaId;

                    } else {
                        $errorMsg.text(data.Message);
                    }
                },
                error: function (xhr, status, error) {
                    $errorMsg.text("取得驗證碼失敗，請稍後再試。");
                }
            }).always(() => {
                $Loder.hide();
            })
        }
        async function fetchCsrfToken() {
            try {
                const API_BASE_URL = '@FTT_VENDER_WEB.Common.Method.GetAppSettingsDataByName("BackendURL")';
                const response = await fetch(`${API_BASE_URL}/antiforgery/token`, {
                    method: 'GET',
                    credentials: 'include'
                });
                if (!response.ok) {
                    throw new Error('Failed to fetch CSRF token');
                }
                const token = response.headers.get('X-CSRF-TOKEN');
                return token;
            } catch (error) {
                console.error("Error getting CSRF token:", error);
                return null;
            }
        }

        function detectIEEdge() {
            var ua = window.navigator.userAgent;

            var msie = ua.indexOf('MSIE ');
            if (msie > 0) {
                // IE 10 or older => return version number
                return parseInt(ua.substring(msie + 5, ua.indexOf('.', msie)), 10);
            }

            var trident = ua.indexOf('Trident/');
            if (trident > 0) {
                // IE 11 => return version number
                var rv = ua.indexOf('rv:');
                return parseInt(ua.substring(rv + 3, ua.indexOf('.', rv)), 10);
            }

            var edge = ua.indexOf('Edge/');
            if (edge > 0) {
                // Edge => return version number
                return parseInt(ua.substring(edge + 5, ua.indexOf('.', edge)), 10);
            }

            // other browser
            return false;
        }
        //IE瀏覽器跳提示
        if (detectIEEdge()) {
            alert("請使用Chrome瀏覽器開啟");
        }

        $(async function () {

            //檢視密碼鈕
            $('#PdDisplay').click(function (e) {
                $('#PdEye').toggleClass('fa-eye');
                $('#PdEye').toggleClass('fa-eye-slash');
                let setPdType = $('#newPD').prop('type') == 'password' ? 'text' : 'password';
                $('#newPD').prop('type', setPdType);
            });

            $('#PdDisplay2').click(function (e)
            {
                $('#PdEye2').toggleClass('fa-eye')
                $('#PdEye2').toggleClass('fa-eye-slash')
                let setPdType = $('#checkNewPD').prop('type') == 'password' ? 'text' : 'password'
                $('#checkNewPD').prop('type', setPdType)
            });

            //FormSubmit事件註冊
            $('#LoginForm').submit(async function (e) {
                e.preventDefault();

                let $errorMsg = $('#errorMsg');


                            let ac = $('#AC').val();
                            let newPD = $('#newPD').val()
                            let checkNewPD = $('#checkNewPD').val()


                            let cptel = $('#cpTel').val()
                            cptel = cptel.replace(/\D/g, ''); //只將數字的部分送往後端

                            if (!ac || !cptel || !newPD || !checkNewPD ) {
                                $errorMsg.text("請填入帳號、聯絡電話、新密碼、確認密碼");
                                return;
                            }

                            if (newPD !== checkNewPD)
                            {
                                $errorMsg.text("新密碼及確認密碼須一致")
                                return
                            }

                            const pattern = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)[A-Za-z\d]{10}$/
                            if (!pattern.test(newPD))
                            {

                                swal({
                                    text: "密碼需符合以下條件：\n1. 長度為10\n2. 含至少一個英文大寫字母\n3. 含至少一個英文小寫字母\n4. 含至少一個數字",
                                    icon: "info",
                                    button: "確認"
                                })
                                return;
                            }
                            $errorMsg.text("");
                            //showLoader()

                            $.ajax({
                                url: '@(config.GetBackendUrl() + Url.Action("Submit", "ChangePw"))',
                                type: 'POST',
                                xhrFields: {
                                    withCredentials: true // ← 這個讓瀏覽器攜帶 Cookie
                                },
                                headers: {
                                    "Content-From": "Login"
                                },
                                data: {
                                    AC: ac,
                                    NewPD: newPD,
                                    cp_tel: cptel
                                },
                                success: function (data) {

                                    console.log(data)
                                    if (data.Success)
                                    {
                                        swal({
                                            text: "密碼已成功更新",
                                            icon: "success",
                                            button: "確認"
                                        }).then(() =>
                                        {
                                            window.location.href = "@Url.Action("Index", "Login")";
                                        })
                                        return;
                                    } else {
                                        swal({
                                            text: data.Message,
                                            icon: "error",
                                            button: "確認"
                                        })
                                        return;
                                    }
                                },
                                error: function (xhr, status, error)
                                {
                                    console.log(xhr)
                                    console.log(status)
                                    console.log(error)
                                    $errorMsg.text("變更密碼失敗，請稍後再試。");
                                }
                            }).always(() => {
                                //hideLoader();
                            })
            });
        });

    </script>
</body>
</html>



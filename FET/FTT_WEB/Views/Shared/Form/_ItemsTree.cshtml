@model ItemsTreeVO
@{
    // 單選的報修項目樹
    // [/CI/node_menu.aspx]ReqSource=ALL&TreeCategory=CI&SelectConstrain=LEAVE&SelectedMode=SINGLE(單選)
    var mapData = new
    {
        IdModal = Model.Id,
        IdBtnOk = Guid.NewGuid(),
        IdTree = Guid.NewGuid().ToString("N"),
        UrlGetListTreeChildren = $"{config.GetBackendUrl()}/Api/GetListTreeChildrenCi",
        UrlGetListTreeItem = $"{config.GetBackendUrl()}/Api/GetListTreeItemCi",
    };
}

<div class="modal fade max100vh" id="@mapData.IdModal" tabindex="-1" role="dialog" aria-labelledby="@mapData.IdModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header text-center">
                <h5>維修品項</h5>
                <button class="btn-close" type="button" aria-label="Close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="@(mapData.IdTree)"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" type="button" id="@mapData.IdBtnOk">確認</button>
            </div>
        </div>
    </div>
</div>

<script>
    var context = context || {};

    $(document).ready(function () {
        if (!context['@(mapData.IdModal)']) {
            context['@(mapData.IdModal)'] = {};
        }

        var ctxModal = context['@(mapData.IdModal)'];
        ctxModal.$Modal = $('#@(mapData.IdModal)');
        // 查詢參數
        ctxModal.reqSrc = '';
        ctxModal.acType = '';
        // 是否必填
        ctxModal.required = ctxModal.required || false;
        ctxModal.result = '';
        ctxModal.selectedItem = null;
        ctxModal.rootNode = {
            id: "1006",
            text: safeText("報修品項"),
            children: true,     // 告訴 jsTree：此節點有子節點，展開時會觸發 AJAX
            state: { opened: false }, // 一開始不打 API，等我們手動展開
            a_attr: { class: 'no-checkbox' },
        };

        ctxModal.Tree = {
            // 暫存的選擇 id
            selected: [],
            // 暫存的選擇項目
            selectedItem: [],
            // tree 是否已 ready
            _isTreeReady: false,
            // 暫存 setValue 在 tree 未 ready 前的值
            _pendingSetValue: null,
            // jsTree 實例
            instance: null,
        };
        ctxModal.$Tree = $('#@(mapData.IdTree)');
        ctxModal.$Tree.jstree({
                force_text:true,
            core: {
                data: function (obj, cb) {
                    // 第一次初始化時，obj.id 為 "#"
                    if (obj.id === "#") {
                        // 回傳 root
                        cb([ctxModal.rootNode]);
                        return;
                    }

                    // 其餘情況：展開節點時 jsTree 會帶入該 node.id
                    $.ajax({
                        url: '@(mapData.UrlGetListTreeChildren?.ToHtmlString())',
                        data: {
                            parentId: obj.id,
                            reqSrc: ctxModal.reqSrc,
                            acType: ctxModal.acType,
                        },
                        type: 'POST',
                        dataType: 'json'
                    }).done(function (response) {
                        if (response.Success) {
                            let data = response.Data || [];
                            $.each(data, function (index, value) {
                                value['a_attr'] = { class: 'no-checkbox' };
                                value['text'] = safeText(value['text']);  // 🔒 encode
                            });
                            cb(data);
                        }
                        else {
                            MyApp.Alert.error(safeText(response['Message'])); // 🔒 encode
                            cb([]);
                        }
                    }).fail((err) => {
                        console.log(err);
                        cb([]);
                    });
                },
                multiple: false,
            },
            dnd: {
                open_timeout: 200     // 強制安全值，避免弱掃判定可控
            },
            plugins: ['checkbox'],
            checkbox: {
                three_state: false,  // 不要自動勾選父節點
                cascade: ''           // 不連動子節點勾選
            },
        });
        ctxModal.$Tree.on('ready.jstree', function (e, data) {
            let instance = data.instance;
            ctxModal.Tree._isTreeReady = true;

            if (!instance.is_open(ctxModal.rootNode.id)) {
                instance.open_node(ctxModal.rootNode.id);
            }

            if (ctxModal.Tree._pendingSetValue) {
                ctxModal.setValue(ctxModal.Tree._pendingSetValue);
                ctxModal.Tree._pendingSetValue = null;
            }
        });
        ctxModal.$Tree.on('changed.jstree', function (e, data) {
            let instance = data.instance;
            // 當前選擇的 node
            let nodeCurrent = data.node;
            // 選擇的 id 陣列
            let selectedNodes = data.selected;
            console.log(selectedNodes);
            ctxModal.Tree.selected = [];
            ctxModal.Tree.selectedItem = null;
            console.log(nodeCurrent);
            if (!instance.is_leaf(nodeCurrent)) {
                instance.deselect_node(nodeCurrent.id);
                return;
            }
            else if (selectedNodes.length) {
                let selectedId = selectedNodes[0];
                ctxModal.Tree.selected = selectedId;
                let node = instance.get_node(selectedId);

                // 確保 node.text 安全
                node.text = safeText(node.text);
                ctxModal.Tree.selectedItem = node;
            }
        });

        $('#@mapData.IdBtnOk').on('click', function () {
            if (ctxModal.required === true) {
                if (ctxModal.Tree.selected.length === 0) {
                    MyApp.Alert.warning('請選擇一個品項');
                    return;
                }
            }

            ctxModal.selectedItem = ctxModal.Tree.selectedItem;
            ctxModal.result = '1';
            ctxModal.$Modal.modal('hide');
        });

        ctxModal.setValue = async function (value) {
            value = value || [];

            if (!ctxModal.Tree._isTreeReady) {
                ctxModal.Tree._pendingSetValue = value;
                return;
            }

            if (value.length) {
                try {
                    let response = await $.ajax({
                        url: '@(mapData.UrlGetListTreeItem?.ToHtmlString())',
                        data: {
                            idList: value,
                            reqSrc: ctxModal.reqSrc,
                            acType: ctxModal.acType,
                        },
                        type: 'POST',
                        dataType: 'json'
                    });

                    if (response.Success === true) {
                        let data = response.Data || [];
                        let setPathId = new Set();
                        // 因為可能執行此段時，根節點尚未展開，所以加上根節點
                        setPathId.add(ctxModal.rootNode.id);
                        $.each(data, function (index, value) {
                            let pathCsv = value['@(nameof(Core.Utility.Web.EX.TreeJsFlatModel.OtherAttr))']['PathCsv'] || '';
                            $.each(pathCsv.split(','), function (index2, value2) {
                                setPathId.add(value2);
                            });
                        });

                        expandTree('@(mapData.IdTree)', Array.from(setPathId), function () {
                            // 等展開完成後再選取
                            value.forEach(id => {
                                ctxModal.Tree.instance.select_node(id);
                            });
                            $('#@(mapData.IdBtnOk)').trigger('click');
                        });
                    }
                    else {
                        MyApp.Alert.error(response.Message);
                    }
                } catch (e) {
                    console.log(e);
                }
            }
        };
    });

    function safeText(value) {
        const div = document.createElement("div");
        div.textContent = value || "";
        return div.innerHTML; // 這是安全的 escape 後字串
    }
</script>
                    </tr>
                    <tr>
                        <th class="table-header">地址</th>
                        <td id="StoreClass_Address"></td>
                    </tr>
                    <tr>
                        <th class="table-header">備註</th>
                        <td id="StoreClass_Note"></td>
                    </tr>

                    <tr>
                        <th class="table-header">開單者</th>
                        <td id="EMPNAME">
                        </td>
                        <th class="table-header">開單者連絡電話</th>
                        <td id="EMPTEL">
                        </td>
                        <th class="table-header">報修型態</th>

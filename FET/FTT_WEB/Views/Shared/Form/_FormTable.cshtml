                            <input id="AMOUNT_MAX_IDX" type="hidden" value="-1" />
                            </div>
                            <table width="100%" id="AMOUNT_LIST" style="background-color:#DEDEDE;" border=1>
                                <tr>
                                    <th> </th>
                                    <th>費用種類</th>
                                    <th>維修細項</th>
                                    <th>檢測故障原因</th>
                                    <th>維修處理動作</th>
                                    <th>數量</th>

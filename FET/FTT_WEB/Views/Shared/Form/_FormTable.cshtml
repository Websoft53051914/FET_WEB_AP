</form>
@* <partial name="Form/_RMItemListSelfVendor" view-data='new ViewDataDictionary(ViewData)' />
    <partial name="Form/_RMItemTree" view-data='new ViewDataDictionary(ViewData)' /> *@

<script>
            function GetFileElement(i, text, value) {
                const a = document.createElement("a");
                a.textContent = `【${text ?? ""}】`;    // 安全，自動 escape
                a.setAttribute("val", value ?? "");
                a.name = `TTItemList[1].FileIds[${i}]`;
                a.target = "_blank";
                a.style.margin = "5px";

                a.href = '@(config.GetBackendUrl() + Url.Action("DownloadFile", "Pending"))'
                    + "?id=" + encodeURIComponent(value ?? "");

                return a;
            }
        if (!String.format) {
            String.format = function (format, ...args) {
                return format.replace(/{(\d+)}/g, function (match, number) {
                    return typeof args[number] != 'undefined'
                        ? args[number]
                        : match
                        ;
                });
            };
        }

        var context = context || {};
        var iFrameIsSubmit = false;

        //initModel.Type : 1.新開單  , 2.自行尋商
        function initFormTable(initModel) {
            if (initModel.Type === 1) {
                $("#rmBtn_SelectItems").on("click", function () {
                    $("#@(TreeModalId)").modal("show");
                });
                $("#SelfFindBussiness").text("N");
            }
            else if (initModel.Type === 2) {
                $("#rmBtn_SelectItems").on("click", function () {
                    $("#RMItemListSelfVendorModal").modal("show");
                });
                $("#SelfFindBussiness").text("Y");
            }
            else if (initModel.Type === 3) {
                $("#rmBtn_SelectItems").remove();
                $("#rmBtn_Add").remove();
                $("#rmBtn_Create").remove();
                $(".rmClass_DeleteDetail").remove();
                $("#rmTable_Header1").html("");
                $("#rmTable_Header1").append("門市資訊")

                // 建立 span
                const statusSpan = document.createElement("span");
                statusSpan.id = "APPROVE_FORM_STATUS_DESC";
                statusSpan.className = "text-success";
                statusSpan.style.cssText = "float:right;background-color: cornsilk;";
                statusSpan.textContent = "*目前表單狀態: 審單中";

                // 安全加入 DOM
                const header = document.getElementById("rmTable_Header1");
                if (header) {
                    header.appendChild(statusSpan);
                }

            }
        }

        $(document).on("CategorySelected", function (event, data) {
            $("#rmBtn_SelectItems").text(data.selectedItemText);
        });

        $(function () {
            $("#FileUpload").on("click", function () {
                var file = $("#File")[0].files[0];
                if (!file) {
                    alert("請選擇檔案");
                    return;
                }

                showLoader();

                var formData = new FormData();
                formData.append("file", file);
                formData.append("formNo", '@form_no');

                $.ajax({
                    url: '@(config.GetBackendUrl() + Url.Action("FileUpload", "Pending"))',
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        hideLoader();
                        if (data.Success) {
                            alert('新增檔案完成');

                            $('#fildTD').append(GetFileElement(data.Data.Text, data.Data.Value));

                            $('#File').val('');
                        } else {
                            alert(data.Message);
                            $('#File').val('');
                        }
                    }
                });

            });
            $(".initSelect2").select2({
                allowClear: true
            });

            $('#COMPLETETIME_Shell').datetimepicker({
                format: 'YYYY/MM/DD',
            });

            $('#PRECOMPLETETIME_Shell').datetimepicker({
                format: 'YYYY/MM/DD',
            });

            $("#TT_CATEGORY").on("change", function (e) {
                if ($('#TT_CATEGORY').val() == "緊急(補單)")
                    MyApp.Alert.warning("【除緊急故障發生，且已電話聯繫，廠商已到場處理者；否則請以「一般」報修處理】");
            });

            $("#SELECTSTATUS").on("change", function (e) {
                $('#COMPLETE_PANEL').hide();
                $('#VENDOR_ARRIVE_DATE_PANEL').hide();
                $('#PENDING_PANEL').hide();
                $('#OFFER_PANEL').hide();
                $('#ASSETER_PANEL').hide();
                $('#AMOUNT_PANEL').hide();

                if ($('#SELECTSTATUS').val() != "") {
                    $('#STATUSWORDING').val($('#SELECTSTATUS').select2('data'));
                    $('#STATUS').val($('#SELECTSTATUS').val());
                    $('#TICKET_INFO').val($('#SELECTSTATUS').val());
                    disable_field($('#VENDOR_ARRIVE_DATE')[0]);

                    var RequireField = '';
                    switch ($('#SELECTSTATUS').val()) {
                        case "COMPLETE":
                            context.RequireField = convertToFormField(",DESCRIPTION,SELECTSTATUS,COMPLETETIME,VENDOR_ARRIVE_DATE,");
                            $('#COMPLETE_PANEL').show();
                            $('#VENDOR_ARRIVE_DATE_PANEL').show();
                            $('#AMOUNT_PANEL').show();
                            enable_field($('#VENDOR_ARRIVE_DATE')[0]);
                            iFrameIsSubmit = false;
                            break;
                        case "PENDING":
                            context.RequireField = convertToFormField(",DESCRIPTION,SELECTSTATUS,PRECOMPLETETIME,");
                            $('#PENDING_PANEL').show();
                            iFrameIsSubmit = true;
                            break;
                        case "OFFER":
                            context.RequireField = convertToFormField(",DESCRIPTION,SELECTSTATUS,PRECOMPLETETIME,PRICE,QTY,");

                            $('#AMOUNT_PANEL').show();
                            $('#PENDING_PANEL').show();
                            iFrameIsSubmit = false;
                            break;

                        case "ASSETER":
                            context.RequireField = '';
                            $('#ASSETER_PANEL').show();
                            iFrameIsSubmit = false;
                            break;

                        case "NOSHOW":
                            context.RequireField = convertToFormField(",DESCRIPTION,SELECTSTATUS,PRECOMPLETETIME,");
                            $('#PENDING_PANEL').show();
                            iFrameIsSubmit = true;
                            break;

                        default:
                            break;
                    }

                    handleRequireField();
                }
            });

            $('#EXPENSE_DESC_SEL').select2({
                placeholder: {
                    id: '',
                    text: '請選擇',
                    selected: 'selected'
                },
                ajax: {
                    url: '@(config.GetBackendUrl() + Url.Action("SelectDesc", "Pending"))',
                    dataType: 'json',
                    type: 'POST',
                    delay: 200,
                    data: function (params) {
                        var selectedTypeName = $('#EXPENSE_TYPE').val();
                        var categoryID = $('#CATEGORY_ID').val();

                        var query = {
                            categoryID: categoryID,
                            ExpenseType: selectedTypeName,
                        }
                        return query;
                    },
                    processResults: function (data) {
                        SetControlEmpty();

                        return {
                            results: $.map(data, (item) => {
                                return {
                                    text: item.Text,
                                    id: item.Value
                                }
                            })
                        };
                    },
                },
            });

            $("#EXPENSE_DESC_SEL").on("change", function (e) {

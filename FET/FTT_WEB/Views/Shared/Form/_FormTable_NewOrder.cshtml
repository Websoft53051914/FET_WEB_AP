<partial name="Form/_RMItemListSelfVendor" view-data='new ViewDataDictionary(ViewData)' />
<partial name="Form/_ItemsTree" model="mapData.PartialIT" />
<partial name="Form/_DialogVender" view-data='new ViewDataDictionary(ViewData)' />

<script>
    function GetFileElement(i, text, value) {
        return '<a val="' + value + '" name="TTItemList[1].FileIds[' + i + ']" target="_blank" href="@(config.GetBackendUrl() + Url.Action("DownloadFile", "Pending"))?id=' + value + '" style="margin: 5px;">【' + text + '】</a>';
    }
    var context = context || {};
    context['IfWarrant'] = 'Y';
    $(function () {
        $("#FileUpload").on("click", function () {
            var file = $("#File")[0].files[0];
            if (!file) {
                alert("請選擇檔案");
                return;
            }

            showLoader();

            var formData = new FormData();
            formData.append("file", file);
            formData.append("formNo", '0');

            $.ajax({
                url: '@(config.GetBackendUrl() + Url.Action("FileUpload", "Pending"))',
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (data) {
                    hideLoader();
                    if (data.Success) {
                        alert('新增檔案完成');

                        $('#fildTD').append(GetFileElement($('#fildTD a').length, data.Data.Text, data.Data.Value));

                        $('#File').val('');
                    } else {
                        alert(data.Message);
                        $('#File').val('');
                    }
                }
            });

        });

        context.TTItemList = {
            count: 0
        };
        //initSelect2
        $(".initSelect2").select2({
            placeholder: "請選擇",
            allowClear: true
        });

        callInitData();
    });

    //initModel.Type : 1.新開單  , 2.自行尋商
    function initFormTable(initModel) {
        if (initModel.Type === 1) {
            $("#rmBtn_SelectItems").on("click", function () {
                $("#@(mapData.PartialIT.Id)").modal("show");
            });
            $("#SELFCONFIG_NOTE").text("N");
            $('#@(Html.IdFor(m => m.TT_CATEGORY))').select2({
                data: [
                    { id: '一般', text: '一般' },
                ]
            });
            $('#@(mapData.PartialIT.Id)').on('hidden.bs.modal', function (e) {
                let ctx = context['@(mapData.PartialIT.Id)'];

                if (ctx.result && ctx.selectedItem) {
                    let data = ctx.selectedItem.original['OtherAttr'];
                    afterSelectCategory(data);
                }
            });
        }
        else if (initModel.Type === 2) {// 自行尋商
            $("#rmBtn_SelectItems").on("click", function () {
                $("#@(ModalId2)").modal("show");
            });
            $("#SELFCONFIG_NOTE").text("Y");
            $('#@(Html.IdFor(m => m.SELFCONFIG))').val('Y');
            $('#btnSelectVender').addClass('d-none');
            $('#@Html.IdFor(m => m.Prompt)').addClass('d-none');
            $('#@(Html.IdFor(m => m.TT_CATEGORY))').select2({
                data: [
                    { id: '一般', text: '一般' },
                    { id: '緊急(補單)', text: '緊急(補單)' },
                ]
            });
            $('#@(ModalId2)').on('hidden.bs.modal', function (e) {
                let ctx = context['@(ModalId2)'];

                if (ctx.result && ctx.selectedItem) {
                    afterSelectCategory(ctx.selectedItem);
                }
            });
        }
    }

    function afterSelectCategory(data) {
        context.categoryData = data;
        let categoryId = data['CATEGORY_ID'] || '';
        let valSELFCONFIG = $('#@(Html.IdFor(m => m.SELFCONFIG))').val();
        // [TTInfo.ascx]getCISID()
        $('#@(Html.IdFor(m => m.TemplateItem.CATEGORY_ID))').val(categoryId);
        $('#CATEGORY_NAME_TMP').val(data['CATEGORY_NAME_TMP'] || '');
        $('#@(Html.IdFor(m => m.TemplateItem.CATEGORY_NAME))').val(data['CATEGORY_NAME'] || '');
        $('#Category_Desc').text(data['CATEGORY_NAME'] || '');
        // 修改類別項目時，廠商也要重新選擇
        if (valSELFCONFIG == 'N') {
            $('#@(Html.IdFor(m => m.TemplateItem.VENDER_ID))').val('');
            $('#VENDER_NAME').text('');
            $('#CP_NAME').text('');
            $('#CP_TEL').text('');
        }

        // [TTInfo.ascx]RetireveItemImage()
        if (data['TT_IMAGE']) {
            $('#TT_IMAGE').attr('src', '@(mapData.UrlImage?.ToHtmlString())' + data['TT_IMAGE']);
        }
        else {
            $('#TT_IMAGE').attr('src', $('#TT_IMAGE').data('defaultSrc'));
        }

        $('#TT_CATEGORY_NOTE_PANNEL').text('');

        if (categoryId) {
            // isNewTT 必定為 true
            // [TTInfo.ascx]RetrieveTTCount()
            showLoader();
            $.ajax({
                url: '@(mapData.UrlRetrieveTTCount?.ToHtmlString())',
                dataType: 'json',
                type: 'POST',
                data: {
                    cisid: categoryId,
                    ivrCode: $('#IVRCODE').val(),
                }
            })
                .done((response) => {
                    var msg = response.Success ? response.Data : response.Message;
                    var alertType = response.Success ? "success" : "error";

                    if (response.Success) {
                        if (response['Data'] == 'YES') {
                            MyApp.Alert.warning('此項目今天已報修，請再確認是否真的要送出！');
                        }
                    }
                    else {
                        MyApp.Alert.error(response.Message);
                    }
                })
                .fail((err) => {
                    console.log(err);
                })
                .always(() => {
                    hideLoader();
                    if (valSELFCONFIG == 'N') {
                        $('#btnSelectVender').click();
                    }
                    // [TTInfo.ascx]RetrieveCategoryNote()
                    let note = data['TT_CATEGORY_NOTE'];
                    if (note) {
                        let list = note.split(';');
                        let $container = $('#TT_CATEGORY_NOTE_PANNEL');
                        let $cblist = [];
                        $.each(list, function (index, value) {
                            let $cb = buildCheckbox({
                                id: value,
                                text: value,
                                name: '@(Html.NameFor(m => m.TemplateItem.ITEMNOTE))[]',
                                inputClassNames: 'cb-item',
                            });
                            $cblist.push($cb);
                        });
                        $container.append($cblist);
                    }
                    // [TTInfo.ascx]RetrieveCategoryDesc()
                    let desc = data['TT_CATEGORY_DESC'];
                    if (desc) {
                        let list = desc.split(';');
                        let $container = $('#TT_CATEGORY_DESC_PANNEL');
                        let $cblist = [];
                        $.each(list, function (index, value) {
                            let $cb = buildCheckbox({
                                id: value,
                                text: value,
                                name: '@(Html.NameFor(m => m.TemplateItem.ITEMDESC))[]',
                                inputClassNames: 'cb-item',
                            });
                            $cblist.push($cb);
                        });
                        $container.append($cblist);
                    }
                });

            // [TTInfo.ascx]setCATEGORY_LABEL
            if (categoryId == '1275') {
                $('#TT_CATEGORY_LABEL').text('報修前確認事項及損壞狀況描述：');
                $('#TT_CATEGORY_NOTE_LABEL').text('報修前檢查事項：');
                $('#TT_CATEGORY_DESC_LABEL').text('報修機台編號：');
                $('#REMARK_LABEL1').text('報修問題描述：');
                $('#REMARK_LABEL2').removeClass('d-none');
            } else {
                $('#TT_CATEGORY_LABEL').text('報修品項檢查事項及狀況描述：');
                $('#TT_CATEGORY_NOTE_LABEL').text('報修品項檢查事項：');
                $('#TT_CATEGORY_DESC_LABEL').text('報修品項狀況描述：');
                $('#REMARK_LABEL1').text('報修描述與備註：');
                $('#REMARK_LABEL2').addClass('d-none');
            }
        }
    }

    function callInitData() {
        let data = {};
        showLoader();
        $.ajax({
            url: '@(mapData.UrlGetInitData?.ToHtmlString())',
            dataType: 'json',
            type: 'POST',
            data: data,
            cache: false
        })
            .done((response) => {
                if (response.Success && response.Data) {
                    let data = response.Data || {};
                    let dataStore = data['@(nameof(Model.StoreVO))'] || {};

                    context['@(mapData.PartialIT.Id)']['reqSrc'] = data['@(Html.IdFor(m => m.ReqSrc))'];
                    context['@(mapData.PartialIT.Id)']['acType'] = data['@(Html.IdFor(m => m.AcType))'];
                    $('#@(Html.IdFor(m => m.CREATE_TIME))Text').text(data['@(Html.IdFor(m => m.CREATE_TIME))']);
                    $('#@(Html.IdFor(m => m.APPROVALDATE))Text').text(data['@(Html.IdFor(m => m.APPROVALDATE))']);
                    $('#@(Html.IdFor(m => m.WARRANTYTIME))Text').text(data['@(Html.IdFor(m => m.WARRANTYTIME))']);
                    $('#@(Html.IdFor(m => m.Prompt))').text(data['@(Html.IdFor(m => m.Prompt))']);
                    $('#@(Html.IdFor(m => m.IVRCODE))').val(data['@(Html.IdFor(m => m.IVRCODE))']);
                    $('#@(Html.IdFor(m => m.EMPNAME))').val(data['@(Html.IdFor(m => m.EMPNAME))']);
                    $('#@(Html.IdFor(m => m.EMPTEL))').val(data['@(Html.IdFor(m => m.EMPTEL))']);
                    Object.keys(dataStore).forEach(function (key) {
                        let safeKey = escapeId(key);

                        let idText = '#StoreVO_' + safeKey + 'Text';
                        if ($(idText).length) {
                            $(idText).text(dataStore[key]);
                        }

                        let id = '#StoreVO_' + safeKey;
                        if ($(id).length) {
                            $(id).text(dataStore[key]);
                        }
                    });

                    if ($('#@(Html.IdFor(m => m.SELFCONFIG))').val() == 'Y') {
                        // 自行尋商的報修廠商固定為登入者
                        $('#@(Html.IdFor(m => m.TemplateItem.VENDER_ID))').val(data['@(Html.IdFor(m => m.IVRCODE))']);
                        $('#@(Html.IdFor(m => m.TemplateItem.VENDER_NAME))').val(data['@(Html.IdFor(m => m.EMPNAME))']);
                        $('#VENDER_NAME_DISPLAY').text(data['@(Html.IdFor(m => m.EMPNAME))']);
                    }

                    if (data['@(nameof(Model.IfWarrant))']) {
                        context['IfWarrant'] = data['@(nameof(Model.IfWarrant))'];
                    }
                }
                else {
                    MyApp.Alert.error('初始化失敗' + response['Message']);
                }
            })
            .fail((err) => {
                console.log(err);
                MyApp.Alert.error('初始化失敗');
            })
            .always(() => {
                hideLoader();
            });
    }

    $('#btnSelectVender').on('click', function (e) {
        let formData = $('#form').serializeObject();
        let valSELFCONFIG = formData['@(nameof(Model.SELFCONFIG))'];
        let valTemplateItem = formData['@(nameof(Model.TemplateItem))'];
        let valCATEGORY_ID = valTemplateItem['@(nameof(NewOrderTTItemVO.CATEGORY_ID))'];

        if (valSELFCONFIG == 'Y') {
            return;
        }

        // [TTInfo.ascx]chooseVendor()
        if (!valCATEGORY_ID) {
            MyApp.Alert.warning('請先選取報修品項，謝謝！');
            return;
        }

        let ctx = context['@(DialogVenderModalId)'];
        ctx['IVRCODE'] = formData['@(nameof(Model.IVRCODE))'];
        ctx['CATEGORY_ID'] = valCATEGORY_ID;
        ctx['IFWARRANT'] = context['IfWarrant'];

        $('#@(DialogVenderModalId)').modal('show');
    });

    $('#rmBtn_Add').on('click', async function (e) {
        // [TTInfo.ascx]insertItem()
        let formData = $('#form').serializeObject();
        let valREPAIR = formData['@(nameof(Model.REPAIR))'];
        let valRESUPPLY = formData['@(nameof(Model.RESUPPLY))']
        let valTemplateItem = formData['@(nameof(Model.TemplateItem))'];
        let valCATEGORY_ID = valTemplateItem['@(nameof(NewOrderTTItemVO.CATEGORY_ID))'];
        let valCATEGORY_NAME = valTemplateItem['@(nameof(NewOrderTTItemVO.CATEGORY_NAME))'];
        let valITEMNOTE = valTemplateItem['@(nameof(NewOrderTTItemVO.ITEMNOTE))'] || [];
        let valITEMDESC = valTemplateItem['@(nameof(NewOrderTTItemVO.ITEMDESC))'] || [];
        let valVENDER_ID = valTemplateItem['@(nameof(NewOrderTTItemVO.VENDER_ID))'];
        let valVENDER_NAME = valTemplateItem['@(nameof(NewOrderTTItemVO.VENDER_NAME))'];
        let valREMARK = valTemplateItem['@(nameof(NewOrderTTItemVO.REMARK))'];

        if (!valCATEGORY_ID) {
            MyApp.Alert.warning('請先選擇報修品項，謝謝！');
            return;
        }

        // [TTInfo.ascx]checkItem()
        let note = context.categoryData['TT_CATEGORY_NOTE'];
        if (note) {
            let list = note.split(';');

            for (let i = 0; i < list.length; i++) {
                if (!valITEMNOTE.includes(list[i])) {
                    MyApp.Alert.warning(`請先檢查項目："${list[i]}"\n\n再重新點選﹝新增資料﹞，謝謝！`);
                    return;
                }
            }
        }

        if (valCATEGORY_ID == '1275') {
            // 檢查 空調-賣場空調 的報修機台編號 是否有勾選
            let desc = context.categoryData['TT_CATEGORY_DESC'];
            if (desc) {
                let list = desc.split(';');

                if (valITEMDESC.length == 0) {
                    if (!valITEMDESC.includes(list[i])) {
                        MyApp.Alert.warning('請選擇報修機台編號\n\n再重新點選﹝新增資料﹞，謝謝！');
                        return;
                    }
                }
            }
        }
        if (!valREPAIR) {
            MyApp.Alert.warning('請先選擇是否[一個月覆修]，謝謝！');
            return;
        }

        if (!valRESUPPLY) {
            MyApp.Alert.warning('請先選擇是否[補單]，謝謝！');
            return;
        }

        // [TTInfo.ascx]formcheckdata()
        try {
            let ret = await $.ajax({
                url: '@(mapData.UrlCheckRepairReported?.ToHtmlString())',
                dataType: 'json',
                type: 'POST',
                data: {
                    categoryId: valCATEGORY_ID,
                }
            });

            if (ret.Success) {
                if (ret.Data == 'Y') {
                    MyApp.Alert.warning('此報修項目已報修，尚有未結案工單！');
                    return;
                }
            }
            else {
                MyApp.Alert.error(ret.Message);
                return;
            }
        } catch (ex) {
            console.log(ex);
            return;
        }


        if (!valVENDER_ID) {
            MyApp.Alert.warning('請先選擇報修廠商，謝謝！');
            return;
        }

        if (!valREMARK) {
            MyApp.Alert.warning('請先填寫報修描述與備註，謝謝！');
            return;
        }

        let idx = context.TTItemList.count;
        let $container = $('#TTItemList');
        let $tr = $('<tr>')
            .attr({
                class: 'grid-item ' + (idx % 2 == 0 ? 'TrOddChild' : 'TrEvenChild'),
            });
        let $td0 = $('<td>');
        let $btnDelete = $('<button>')
            .attr({
                'class': 'btn btn-link text-danger icofont icofont-trash fs-6 p-1',
                'type': 'button',
            })
            .on('click', (e) => {
                var $control = $(e.currentTarget);
                const callDelete = () => {
                    let $trNow = $control.closest('tr');
                    $trNow.remove();
                    let $trList = $container.children('tr.grid-item');
                    context.TTItemList.count = $trList.length;

                    if ($trList.length) {
                        $.each($trList, function (index, value) {
                            let $tr = $(value);
                            $tr.find('input,select,textarea').each(function () {
                                let name = $(this).attr('name');
                                if (name) {
                                    let newName = name.replace(/\[\d+\]/, "[" + index + "]");
                                    $(this).attr("name", newName);
                                }
                            });

                            $tr.removeClass('TrOddChild');
                            $tr.removeClass('TrEvenChild');
                            $tr.addClass((index % 2 == 0 ? 'TrOddChild' : 'TrEvenChild'));
                        });
                    }
                    else {
                        $('#noData').removeClass('d-none');
                    }
                };

                MyApp.Alert.confirm('@(config.GetMessage("BeforeDeleteMsg").ToHtmlString())')
                    .then((result) => {
                        if (result) {
                            callDelete();
                        }
                    });
            });
        $td0.append($btnDelete);
        $tr.append($td0);

        let $td1 = $('<td>');
        let $categoryId = $('<input>')
            .attr({
                type: 'hidden',
                name: `@(nameof(Model.TTItemList))[${idx}].@(nameof(NewOrderTTItemVO.CATEGORY_ID))`,
                value: valCATEGORY_ID
            });
        let $categoryName = $('<input>')
            .attr({
                type: 'hidden',
                name: `@(nameof(Model.TTItemList))[${idx}].@(nameof(NewOrderTTItemVO.CATEGORY_NAME))`,
                value: valCATEGORY_NAME
            });
        let $categoryNameDisplay = $('<span>')
            .text(valCATEGORY_NAME);
        $td1.append($categoryId);
        $td1.append($categoryName);
        $td1.append($categoryNameDisplay);
        $tr.append($td1);

        let $td2 = $('<td>');
        let $venderId = $('<input>')
            .attr({
                type: 'hidden',
                name: `@(nameof(Model.TTItemList))[${idx}].@(nameof(NewOrderTTItemVO.VENDER_ID))`,
                value: valVENDER_ID
            });
        let $venderNameDisplay = $('<span>')
            .text(valVENDER_NAME);
        $td2.append($venderId);
        $td2.append($venderNameDisplay);
        $tr.append($td2);

        let $td3 = $('<td>');
        let valItemNoteVal = valITEMNOTE.join(',');
        let $itemNoteVal = $('<input>')
            .attr({
                type: 'hidden',
                class: 'form-control',
                name: `@(nameof(Model.TTItemList))[${idx}].@(nameof(NewOrderTTItemVO.ItemNoteVal))`,
                value: valItemNoteVal
            });
        let $itemNoteValDisplay = $('<span>')
            .text(valItemNoteVal);
        let valItemDescVal = valITEMDESC.join(',');
        let $itemDescVal = $('<input>')
            .attr({
                type: 'hidden',
                class: 'form-control',
                name: `@(nameof(Model.TTItemList))[${idx}].@(nameof(NewOrderTTItemVO.ItemDescVal))`,
                value: valItemDescVal
            });
        let $itemDescValDisplay = $('<span>')
            .text(valItemDescVal);
        $td3.append($itemNoteVal);
        $td3.append($itemNoteValDisplay);
        $td3.append($('<br/>'));
        $td3.append($itemDescVal);
        $td3.append($itemDescValDisplay);
        $tr.append($td3);

        let $td4 = $('<td>');
        let $remark = $('<input>')
            .attr({
                type: 'hidden',
                class: 'form-control',
                name: `@(nameof(Model.TTItemList))[${idx}].@(nameof(NewOrderTTItemVO.REMARK))`,
                value: valREMARK
            });
        let $remarkDisplay = $('<span>')
            .text(valREMARK);
        $td4.append($remark);
        $td4.append($remarkDisplay);
        $tr.append($td4);
        let $td5 = $('<td>');

        // 處理 hidden inputs
        $('#fildTD').find('a').each(function (i, item) {
            let $file = $('<input>')
                .attr({
                    type: 'hidden',
                    class: 'form-control',
                    name: `@(nameof(Model.TTItemList))[${idx}].@(nameof(NewOrderTTItemVO.FileIds))[${i}]`,
                    value: $(item).attr('val') // safe
                });

            $td5.append($file);
        });

        // 安全插入 <a> 元素
        $('#fildTD').find('a').each(function () {
            let $original = $(this);
            let $safeLink = $('<a>')
                .attr('href', $original.attr('href') || '#') // 保留 href
                .text($original.text());                     // 只插入文字，escape HTML
            $td5.append($safeLink);
        });

        $tr.append($td5);
        $container.append($tr);

        context.TTItemList.count = idx + 1;
        $('#noData').addClass('d-none');
    });

    $('#@(Html.IdFor(m => m.TT_CATEGORY))').on('change.select2', function (e) {
        var $control = $(e.currentTarget);
        var data = $control.select2('data');

        if (data && data.length) {
            let selectedItem = data[0];
            if (selectedItem.text == '緊急(補單)') {
                MyApp.Alert.warning('【除緊急故障發生，且已電話聯繫，廠商已到場處理者；否則請以「一般」報修處理】');
            }
        }
    });

    $('#@(DialogVenderModalId)').on('hidden.bs.modal', function (e) {
        let ctx = context['@(DialogVenderModalId)'];

        if (ctx.result && ctx.selectedItem) {
            let data = ctx.selectedItem;
            if ($('#SELFCONFIG').val() == 'N') {
                $('#@(Html.IdFor(m => m.TemplateItem.VENDER_ID))').val(data['id']);
                $('#@(Html.IdFor(m => m.TemplateItem.VENDER_NAME))').val(data['text']);
                $('#VENDER_NAME_DISPLAY').text(data['text']);
                $('#CP_NAME').text(data['OtherAttr']['CP_NAME']);
                $('#CP_TEL').text(data['OtherAttr']['CP_TEL']);
                $('#btnSelectVender').removeClass('d-none');
            }
        }
    });
    function escapeId(str) {
        return String(str).replace(/[^A-Za-z0-9\-_:.]/g, "_");
    }
</script>

                        <td colspan="6">
                            <div class="table-responsive  bg-white pt-1">
                                <table class="table table-bordered align-middle" style="table-layout: fixed;">
                                    <tbody id="TTItemList">
                                        <tr>
                                            <th style="width:50px">刪</th>
                                            <th>維修品項</th>

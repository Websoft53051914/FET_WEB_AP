@model NewOrderVO
@{
    string ModalId2 = Guid.NewGuid().ToString("N");
    ViewData["ModalId2"] = ModalId2;
    string DialogVenderModalId = Guid.NewGuid().ToString("N");
    ViewData["DialogVenderModalId"] = DialogVenderModalId;
    var mapData = new
    {
        PartialIT = new ItemsTreeVO(),
        UrlGetInitData = $"{config.GetBackendUrl()}/NewOrder/GetInitData",
        UrlRetrieveTTCount = $"{config.GetBackendUrl()}/NewOrder/RetrieveTTCount",
        UrlCheckRepairReported = $"{config.GetBackendUrl()}/NewOrder/CheckRepairReported",
        UrlImage = $"{config.GetBackendUrl()}/",
        UrlImageNoProduct = $"{config.GetBackendUrl()}/Item/no-product.gif",

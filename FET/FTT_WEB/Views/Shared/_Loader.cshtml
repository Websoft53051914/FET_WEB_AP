@{
    Layout = null;
}
<style>
    .loader-wrapper {
        background-color: rgba(255,255,255, .5);
    }
</style>
<script>
    function showLoader(msg) {
        var safeMsg = escapeHtml_showLoader(msg);

        // <div class="loader-wrapper">
        var wrapper = document.createElement("div");
        wrapper.className = "loader-wrapper";

        var themeLoader = document.createElement("div");
        themeLoader.className = "theme-loader";

        var loaderP = document.createElement("div");
        loaderP.className = "loader-p";

        var h3 = document.createElement("h3");
        h3.className = "position-relative top-100 text-center font-primary";
        h3.textContent = safeMsg;   // ✔ 使用 textContent（無 XSS）

        loaderP.appendChild(h3);
        themeLoader.appendChild(loaderP);
        wrapper.appendChild(themeLoader);

        // ✔ DOM append（不會被掃描誤判）
        document.body.appendChild(wrapper);
    }

    function hideLoader() {
        $('.loader-wrapper').fadeOut('slow', function () {
            this.remove();
        });
    }

    function escapeHtml_showLoader(text) {
        if (typeof text !== 'string') text = text || '';
        return text.replace(/[&<>"']/g, function (m) {
            return ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            })[m];
        });
    }
</script>

<script src="~/js/handlebars.min-v4.7.7.js"></script>
@model NewOrderVO
@{ 
    var mapData = new
    {
        UrlPost = $"{config.GetBackendUrl()}/NewOrder/Create",
        UrlFile1 = $"{config.GetBackendUrl()}/開放門市自行尋商.xlsx",
    };
}

<div class="container-fluid">
    <div class="page-header" style="padding-bottom:20px">
        <div class="row">
            <div class="col-sm-6">
                <h3>自行尋商開單</h3>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Home" data-bs-original-title="" title="">首頁</a></li>
                    <li class="breadcrumb-item">功能</li>
                    <li class="breadcrumb-item active"><a href="" data-bs-original-title="" title="">自行尋商開單</a></li>
                </ol>
            </div>
            <div class="col-sm-6  websoft-function-row-copy d-flex justify-content-end gap-2">
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card">
        <div class="card-body" style="margin:0 !important ; padding:20px !important">
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr align="right">
                    <td colspan="2" valign="bottom">
                        <a href="@(mapData.UrlFile1?.ToHtmlString())" target="_blank" style="color:white; background-color:red; font-size:12pt; font-weight:bolder;" title="開放門市自行尋商項目">開放門市自行尋商項目</a>
                    </td>
                </tr>
            </table>
            @await Html.PartialAsync("Form/_FormTable_NewOrder", Model, ViewData)
        </div>
    </div>
</div>

@section scripts
{
    <script>
        var context = context || {};

        $(function () {
            initFormTable({
                Type: 2
            });
        });

        $('#rmBtn_Create').on('click', function (e) {
            if (context.TTItemList.count == 0) {
                MyApp.Alert.warning('請先新增報修資料，謝謝！');
                return;
            }

            let formData = $('#form').serializeObject();
            let data = {};
            $.extend(data, formData);
            showLoader();
            $.ajax({
                url: '@(mapData.UrlPost?.ToHtmlString())',
                dataType: 'json',
                type: 'POST',
                data: data,
                cache: false
            })
                .done((response) => {
                    if (response.Success) {
                        MyApp.Alert.success(response['Data'])
                            .then((result) => {
                                console.log('window.opener', window.opener);
                                if (window.opener) {
                                    window.opener.location.reload();
                                }
                                else {
                                    location.reload();
                                }
                            });
                    }
                    else {
                        MyApp.Alert.error(response['Message']);
                    }
                })
                .fail((err) => {
                    console.log(err);
                })
                .always(() => {
                    hideLoader();
                });
        });
    </script>
}

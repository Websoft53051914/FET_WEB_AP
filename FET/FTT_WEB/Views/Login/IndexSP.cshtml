        <div class=" child row justify-content-center">
            <div class="login-table col-12 col-sm-10 col-md-8 mt-sm-3 p-0 d-flex justify-content-center">
                <div class="form-mask row  w-100" style="text-align:center;">
                    <label>
                        請稍後
                    </label>
                </div>
            </div>
        </div>
    </div> *@

    <div id="loader-mask" style="position:fixed; top:0 ;width:100%;height:100%;background-color:#80808080;display:none">
    </div>
    <script src="~/lib/viho/assets/js/jquery-3.5.1.min.js"></script>
    <script>
        const $Loder = $('#loader-mask');

        function detectIEEdge() {
            var ua = window.navigator.userAgent;

            var msie = ua.indexOf('MSIE ');
            if (msie > 0) {
                // IE 10 or older => return version number
                return parseInt(ua.substring(msie + 5, ua.indexOf('.', msie)), 10);
            }

            var trident = ua.indexOf('Trident/');
            if (trident > 0) {
                // IE 11 => return version number
                var rv = ua.indexOf('rv:');
                return parseInt(ua.substring(rv + 3, ua.indexOf('.', rv)), 10);
            }

            var edge = ua.indexOf('Edge/');
            if (edge > 0) {
                // Edge => return version number
                return parseInt(ua.substring(edge + 5, ua.indexOf('.', edge)), 10);
            }

            // other browser
            return false;
        }
        //IE瀏覽器跳提示
        if (detectIEEdge()) {
            alert("請使用Chrome瀏覽器開啟");
        }

        function pro() {
            const urlParams = new URLSearchParams(window.location.search);

            //20260416 Add begin - 新版加密 token 參數優先（資安要求，取代明碼 IVRCODE/EMPNO/RETAILID）
            // ── 新版：加密 token 參數（優先使用）────────────────────────────
            if (urlParams.has('token')) {
                const token = urlParams.get('token');

                $.ajax({
                    type: 'POST',
                    xhrFields: { withCredentials: true },
                    headers: { "Content-From": "Login" },
                    url: '@(config.GetBackendUrl() + Url.Action("CheckSSO_Encrypted", "login"))',
                    data: { token: token },
                    dataType: 'json',
                    success: function (data) {
                        if (data.Success == true) {
                            window.location.href = "@Url.Action("index", "home")";
                        } else {
                            alert(data.Message);
                            window.location.href = "../login/index";
                        }
                    },
                    error: function (msg) {
                        console.log(msg);
                        alert('呼叫 API 異常');
                    }
                });
                return;
            }
            //20260416 Add end

            // ── 舊版：明碼參數（向下相容，未來可移除）───────────────────────
            if (urlParams.has('IVRCODE') == false || urlParams.has('EMPNO') == false || urlParams.has('RETAILID') == false) {
                alert('資料不正確');
                window.location.href = "../login/index";
                return;
            }

            const IVRCODE = urlParams.get('IVRCODE');
            const EMPNO = urlParams.get('EMPNO');
            const RETAILID = urlParams.get('RETAILID');

            $.ajax({
                type: 'POST',
                xhrFields: {
                    withCredentials: true // ← 這個讓瀏覽器攜帶 Cookie
                },
                headers: {
                    "Content-From": "Login"
                },
                url: '@(config.GetBackendUrl() + Url.Action("checkSSO", "login"))',
                data: {
                    IVRCODE: IVRCODE,
                    EMPNO: EMPNO,
                    RETAILID: RETAILID,
                },
                dataType: 'json',
                success: function (data) {
                    if (data.Success == true) {
                        window.location.href = "@Url.Action("index", "home")";
                    } else {
                        alert(data.Message);
                        window.location.href = "../login/index";
                    }
                },
                error: function (msg) {
                    console.log(msg);
                    alert('呼叫 API 異常');
                }
            });
        }


        $(function () {
            pro();
        })
    </script>
</body>
</html>



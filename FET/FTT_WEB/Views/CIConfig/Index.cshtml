@model CIConfigIndexVO
@{
    var mapData = new
    {
        Grid = new
        {
            Id = Guid.NewGuid().ToString("N"),
            IdPageSelect = Guid.NewGuid().ToString("N"),
            IdPagers = Guid.NewGuid().ToString("N"),
            UrlGetPageList = $"{config.GetBackendUrl()}/CIConfig/GetPageList",
        },
        FormSearch = new
        {
            Id = Guid.NewGuid().ToString("N"),
            IdBtnSearch = Guid.NewGuid().ToString("N"),
        },
        UrlExportExcel = $"{config.GetBackendUrl()}/CIConfig/ExportExcel",
        UrlImportExcel = $"{config.GetBackendUrl()}/CIConfig/ImportExcel",
    };
}

<div class="container-fluid">
    <div class="page-header" style="padding-bottom:20px">
        <div class="row">
            <div class="col-sm-6">
                <h3>例外派工維護</h3>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Home" data-bs-original-title="" title="">首頁</a></li>
                    <li class="breadcrumb-item">功能</li>
                    <li class="breadcrumb-item active"><a href="" data-bs-original-title="" title="">例外派工維護</a></li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <form id="@(mapData.FormSearch.Id)">
        <div class="card mb-2">
            <div class="card-body py-3 card-body-reduction">
                <div class="row  mb-2">
                    <div class="col-xl-3 col-lg-4 col-sm-6 col-12">
                        <label asp-for="ShopNameLike" class="col-form-label websoft-form-label pt-2">門市</label>
                        <input asp-for="ShopNameLike" type="text" class="form-control" placeholder="">
                    </div>
                </div>
                <button id="@(mapData.FormSearch.IdBtnSearch)" type="button" class="btn btn-primary">送出查詢</button>
                <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#BatchModal">資料更新</button>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <div id="@(mapData.Grid.Id)"></div>
                <div class="d-block d-md-flex justify-content-md-end align-items-center pagination">
                    <div id="pageResizer" class="jsgrid-pager-page">
                        <span>每頁筆數:</span>
                        <select id="@(mapData.Grid.IdPageSelect)">
                        </select>
                    </div>
                    <div id="@(mapData.Grid.IdPagers)">
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="modal fade" id="BatchModal" tabindex="-1" role="dialog" aria-labelledby="BatchModal" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="BatchModalLabel">資料匯入</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input id="file" class="form-control" type="file" accept=".xlsx,.xls" style="max-width:500px" />
                <div class="text-warningv2 mt-2" role="alert">
                    <p>執行註記 (A:新增  U:更新  D:刪除 )</p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="btnImportExcel" class="btn btn-primary" type="button">匯入資料</button>
                <button id="btnExportExcel" class="btn btn-primary" type="button">匯出資料</button>
            </div>
        </div>
    </div>
</div>


@section scripts
{
    <script>
        var context = {

        };
        var cookieName = 'CIConfigGridInfo';

        $(function () {
            let pageIndex = 1;
            let pageSize = pageDataSource[0].id;
            if (Cookies.get(cookieName)) {
                var cookieObj = JSON.parse(Cookies.get(cookieName));
                if (cookieObj && cookieObj.FromEdit == true) {
                    if (cookieObj.PageIndex) {
                        pageIndex = parseInt(cookieObj.PageIndex);
                    }

                    if (cookieObj.PageSize) {
                        pageSize = parseInt(cookieObj.PageSize);
                    }

                    Cookies.remove(cookieName);
                }
            }
            initGrid(pageIndex, pageSize);
        });

        $('#@(mapData.FormSearch.IdBtnSearch)').on('click', function (e) {
            context['@(mapData.Grid.Id)'].reload();
        });

        $('#btnExportExcel').on('click', function (e) {
            let data = {};
            $.extend(data, $('#@(mapData.FormSearch.Id)').serializeObject(), context['@(mapData.Grid.Id)'].filter);

            postSubmitJson('@(mapData.UrlExportExcel?.ToHtmlString())', data);
        });

        $('#btnImportExcel').on('click', function (e) {
            var file = $('#file')[0].files[0];
            if (!file || !file.size) {
                MyApp.Alert.warning("請選擇檔案");
                return;
            }

            var fileName = file.name.toLowerCase();
            if (!(fileName.endsWith('.xls') || fileName.endsWith('.xlsx'))) {
                MyApp.Alert.warning('只能上傳 Excel 檔 (.xls / .xlsx)');
                return;
            }
            console.log(file);
            showLoader();
            var formData = new FormData();
            formData.append("file", file);

            $.ajax({
                url: '@(mapData.UrlImportExcel?.ToHtmlString())',
                dataType: 'json',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
            })
                .done((response) => {
                    if (response.Success) {
                        MyApp.Alert.success('匯入成功!');
                    }
                    else {
                        MyApp.Alert.error(response.Message);
                    }
                })
                .fail((err) => {
                    console.log(err);
                })
                .always(() => {
                    hideLoader();
                });
        });
    </script>
    <script>
    function initGrid(cookiePageIndex, cookiePageSize) {
        context['@(mapData.Grid.Id)'] = {};
        var ctxGrid = context['@(mapData.Grid.Id)'];
        ctxGrid.$Grid = $('#@(mapData.Grid.Id)');
        ctxGrid.$Grid.jsGrid({
            pageIndex: cookiePageIndex,
            paging: true,
            pageSize: cookiePageSize,
            pageLoading: true,
            pagerContainer: '#@(mapData.Grid.IdPagers)',
            autoload: true,
            controller: {
                loadData: function (filter) {
                    var d = $.Deferred();
                    ctxGrid.filter = { ...filter };
                    filter.vm = {};
                    $.extend(filter.vm, $('#@(mapData.FormSearch.Id)').serializeObject());

                    //分頁頁數紀錄相關 紀錄查詢時將查詢條件、頁數 start
                    var cookieobj = {
                        PageIndex: filter.pageIndex,
                        PageSize: filter.pageSize,
                        ...filter.vm
                    };
                    Cookies.set(cookieName, JSON.stringify(cookieobj), { expires: 1 });

                    $.ajax({
                        type: 'POST',
                        url: '@(mapData.Grid.UrlGetPageList?.ToHtmlString())',
                        data: filter,
                        dataType: 'json',
                        success: function (res) {
                            if (res.Success === false) {
                                MyApp.Alert.error(res.Message);
                                d.reject();
                                return;
                            }
                            var da = {
                                data: res.Data,
                                itemsCount: res.Total
                            }
                            d.resolve(da);
                        }
                    });

                    return d.promise();
                }
            },
            fields: [
                { name: '@(nameof(CIConfigGridVO.Cisid))', title: 'CISID', type: 'text', width: 120, align: 'center' },
                { name: '@(nameof(CIConfigGridVO.Aciname))', title: '報修類別', type: 'text', width: 200, align: 'center' },
                { name: '@(nameof(CIConfigGridVO.VendorId))', title: '廠商代碼', type: 'text', width: 120, align: 'center' },
                { name: '@(nameof(CIConfigGridVO.MerchantName))', title: '廠商名稱', type: 'text', width: 180, align: 'center' },
                { name: '@(nameof(CIConfigGridVO.Ivrcode))', title: 'IVRCODE', type: 'text', width: 120, align: 'center' },
                { name: '@(nameof(CIConfigGridVO.ShopName))', title: '門市名稱', type: 'text', width: 180, align: 'center' },
                { name: '@(nameof(CIConfigGridVO.ApprovalDateText))', title: '驗收日期', type: 'text', width: 120, align: 'center' },
                { width: 'auto' }
            ],
        });

        //分頁頁數紀錄相關
        ctxGrid.$Grid.jsGrid('_setPage', cookiePageIndex);//jsgrid bug 不會自動將頁碼設定成pageindex

        $('#@(mapData.Grid.IdPageSelect)').select2({
            minimumResultsForSearch: -1,
            data: pageDataSource
        });
        $('#@(mapData.Grid.IdPageSelect)').data('select2').$container.addClass('w-auto');
        $('#@(mapData.Grid.IdPageSelect)').on('change', (e) => {
            onPageLenghtSelect(e.currentTarget.value, ctxGrid.$Grid);
        });
        ctxGrid.reload = function () {
            ctxGrid.$Grid.jsGrid('search');
        };
    }
    </script>
}

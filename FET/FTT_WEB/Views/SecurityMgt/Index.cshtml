@{
    var mapText = new
    {
        Btn_Search = "查詢",
        Btn_Clear = "清除",
        Btn_Create = "新增",
        Btn_Confirm = "確認",
        Btn_Cancel = "取消",
    };

    var mapAttr = new
    {
        IdGrid = Guid.NewGuid(),
        IdBtnSearch = Guid.NewGuid(),
    };

    var mapUrl = new
    {
        Delete = Url.Action("Delete"),
    };
}

<div class="container-fluid">
    <div class="page-header" style="padding-bottom:20px">
        <div class="row">
            <div class="col-sm-6">
                <h3>保全廠商維護</h3>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Home" data-bs-original-title="" title="">首頁</a></li>
                    <li class="breadcrumb-item">後端功能</li>
                    <li class="breadcrumb-item active"><a href="" data-bs-original-title="" title="">保全廠商維護</a></li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    @* <div class="card mb-2">
    <div class="card-body py-3 card-body-reduction">
    <input class="form-control" type="file" style="max-width:500px" />
    <div class="text-warningv2 mt-2" role="alert">
    <p class="mb-0">IVRCODE與廠商代碼為必填欄位</p>
    <p>若要刪除資料[刪除註記]請填 'D'</p>
    </div>
    </div>
    <div class="card-footer py-3">
    <button class="btn btn-primary" type="button">匯入資料</button>
    <button class="btn btn-primary" type="button">匯出資料</button>
    </div>
    </div> *@
    <div class="card mb-2">
        <div class="card-body py-3 card-body-reduction">
            <div class="row  mb-2">
                <div class="col-xl-3 col-lg-4 col-sm-6 col-12">
                    <label class="col-form-label websoft-form-label pt-2">店名</label>
                    <input type="text" class="form-control" placeholder="" id="shop_name">
                </div>
            </div>
            <button class="btn btn-primary" id="@(mapAttr.IdBtnSearch)">送出查詢</button>
            <button class="btn btn-info" data-bs-toggle="modal" data-bs-target="#BatchModal">資料更新</button>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div id="@(mapAttr.IdGrid)"></div>
            <div class="d-block d-md-flex justify-content-md-end align-items-center pagination">
                <div id="pageResizer" class="jsgrid-pager-page">
                    <span>每頁筆數:</span>
                    <select id="pageSelect">
                    </select>
                </div>
                <div id="pagers">
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="BatchModal" tabindex="-1" role="dialog" aria-labelledby="BatchModal" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="BatchModalLabel">資料匯入</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input class="form-control" type="file" id="File" style="max-width:500px" />
                <div class="text-warningv2 mt-2" role="alert">
                    <p class="mb-0">IVRCODE與廠商代碼為必填欄位</p>
                    <p>若要刪除資料[刪除註記]請填 'D'</p>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" type="button" id="btnImport">匯入資料</button>
                <button class="btn btn-primary" type="button" id="btnExport">匯出資料</button>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script>

        const context = {
            $Grid: $("#@(mapAttr.IdGrid)"),
        };

        $(function () {
            initGrid(1);

            $("#pageSelect").on("change", function () {
                const val = this.value;
                onPageLenghtSelect(val, context.$Grid);
            })

            $("#pageSelect").select2({
                minimumResultsForSearch: -1,
                data: pageDataSource
            });
            $("#pageSelect").data("select2").$container.addClass("w-auto");

            $('.initDatepicker').datetimepicker({
                format: 'YYYY/MM/DD',
            });

            $(".select2-Clear").select2({
                placeholder: "請選擇",
                allowClear: true,
            });

            $('#@(mapAttr.IdBtnSearch)').on('click', (e) => {
                context.$Grid.jsGrid('search');
            });

            $('#btnImport').on('click', (e) => {
                var file = $("#File")[0].files[0];
                if (!file) {
                    alert("請選擇檔案");
                    return;
                }

                var fileName = file.name.toLowerCase();
                if (!(fileName.endsWith(".xls") || fileName.endsWith(".xlsx"))) {
                    alert("只能上傳 Excel 檔 (.xls / .xlsx)");
                    return;
                }

                showLoader();

                // 通過才上傳
                var formData = new FormData();
                formData.append("file", file);

                $.ajax({
                    url: '@(config.GetBackendUrl() + Url.Action("Import", "SecurityMgt"))',
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        hideLoader();
                        if (data.Success) {
                            alert(data.Data);
                            $('#File').val('');
                        } else {
                            alert(data.Message);
                            $('#File').val('');
                        }
                    }
                });
            });
            $('#btnExport').on('click', (e) => {
                showLoader();

                $.ajax({
                    url: '@(config.GetBackendUrl() + Url.Action("Export", "SecurityMgt"))',
                    method: 'GET',
                    xhrFields: { responseType: 'blob' },  // 讓回傳是二進位資料
                    success: function (data, status, xhr) {
                        // 從 Content-Disposition 取得檔名
                        var disposition = xhr.getResponseHeader('Content-Disposition');
                        var fileName = "download.xlsx";
                        if (disposition && disposition.indexOf('filename=') !== -1) {
                            var matches = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/.exec(disposition);
                            if (matches != null && matches[1]) {
                                fileName = decodeURIComponent(matches[1].replace(/['"]/g, ''));
                            }
                        }

                        // 建立 Blob 並觸發下載
                        var blob = new Blob([data], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
                        var url = window.URL.createObjectURL(blob);

                        var a = document.createElement("a");
                        a.href = url;
                        a.download = fileName;
                        document.body.appendChild(a);
                        a.click();
                        a.remove();

                        window.URL.revokeObjectURL(url);
                        hideLoader();
                    }
                });
            });
        });

        function initGrid(cookiePageIndex) {
            $("#@(mapAttr.IdGrid)").jsGrid({
                pageIndex: cookiePageIndex,
                paging: true,
                width: "100%",
                pageSize: pageDataSource[0].id,
                pageButtonCount: 5,
                pagerFormat: "{first} {prev} {pages} {next} {last}    第 {pageIndex} 頁 共 {pageCount} 頁",
                pagePrevText: "上一頁",
                pageNextText: "下一頁",
                pageFirstText: "第一頁",
                pageLastText: "最後一頁",
                pageLoading: true,
                autoload: true,
                changePageSize: function (pageSize) {
                    var $this = this;
                    $this.pageSize = pageSize;

                    context.$Grid.jsGrid("openPage", 1);
                },
                pagerContainer: "#pagers",
                onDataLoaded: function () {
                    feather.replace();
                },
                controller: {
                    loadData: function (filter) {
                        var d = $.Deferred();

                        var shop_name = $('#shop_name').val();
                        filter.vm = {
                            shop_name: shop_name,
                        };

                        $.ajax({
                            type: "POST",
                            url: "@(config.GetBackendUrl() + Url.Action("GetPageList"))",
                            data: filter,
                            dataType: "json",
                            success: function (res) {
                                if (res.Success === false) {
                                    swal({
                                        text: res.Message,
                                        icon: "error",
                                        button: "確認"
                                    });
                                    d.reject();
                                    return;
                                }
                                var da = {
                                    data: res.Data,
                                    itemsCount: res.Total
                                }
                                d.resolve(da);
                            }
                        })

                        return d.promise();
                    }
                },
                fields: [
                    { name: "Id", visible: false },
                    {
                        type: 'control', align: "center",
                        editButton: false,
                        deleteButton: false,
                        headerTemplate: (value, item) => {
                            return $("<div>操作<div>").attr({ class: '' });
                        },
                        itemTemplate: (value, item) => {

                            $div = $('<div>')
                            // $editButton = $('<a>')
                            //     .attr({
                            //         'class': 'jsgrid-button jsgrid-edit-button d-inline-block',
                            //         'href': "",
                            //     })

                            $deleteButton = $('<button>')
                                .attr({
                                    'class': 'exclick jsgrid-button jsgrid-delete-button',
                                })
                                .on('click', () => {
                                    const callDelete = () => {
                                        var data = {
                                            ivrcode: item['ivrcode']
                                        };

                                        $.ajax({
                                            url: '@(config.GetBackendUrl() + mapUrl.Delete.ToHtmlString())',
                                            dataType: 'json',
                                            type: 'POST',
                                            data: data
                                        })
                                            .done((response) => {
                                                var msg = response.Success ? response.Data : response.Message;
                                                var alertType = response.Success ? "success" : "error";

                                                swal({
                                                    text: msg,
                                                    button: '@(mapText.Btn_Confirm.ToHtmlString())',
                                                    icon: alertType
                                                }).then((result) => {
                                                    if (result) {
                                                        context.$Grid.jsGrid('search');
                                                    }
                                                });
                                            });
                                    }

                                    swal({
                                        text: `@config.GetMessage("BeforeDeleteMsg").ToHtmlString()`,
                                        buttons: ['@(mapText.Btn_Cancel.ToHtmlString())', '@(mapText.Btn_Confirm.ToHtmlString())'],
                                        icon: "info"
                                    }).then((result) => {
                                        console.log(result);
                                        if (result) {
                                            callDelete();
                                        }
                                    });
                                });

                            // var result = $div.append($editButton);
                            var result = $div.append($deleteButton);
                            return result;
                        }
                    },
                    // IVR_CODE , 店名 , 廠商代碼 , 廠商名稱 , 聯絡人姓名 , 聯絡電話
                    { name: "ivrcode", title: "IVR_CODE", type: "text", width: 100, align: "center" },
                    { name: "shop_name", title: "店名", type: "text", width: 150, align: "center" },
                    { name: "vendor_id", title: "廠商代碼", type: "text", width: 150, align: "center" },
                    { name: "merchant_name", title: "廠商名稱", type: "text", width: 150, align: "center" },
                    { name: "cp_name", title: "聯絡人姓名", type: "text", width: 150, align: "center" },
                    { name: "cp_tel", title: "聯絡電話", type: "text", width: 150, align: "center" },
                ],

            });

            //分頁頁數紀錄相關
            context.$Grid.jsGrid('_setPage', cookiePageIndex);//jsgrid bug 不會自動將頁碼設定成pageindex
        }

    </script>
}

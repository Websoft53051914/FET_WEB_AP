                    }
                    break;
                case "Start":
                    var area = shopform.area.options.value;
                    alert(area);
                    var cvalue = shopform.channel.value;
                    alert(cvalue);
                    if (cvalue != "") {
                        cvalue = shopform.area.value;
                        shopform.area.options[0].value = '';
                        shopform.area.options[0].text = '請選擇';

                        for (var i = index - 1; i >= 0; i--) {
                            shopform.area.options.remove(i);
                        }

                        if (objvalue == "RETAIL" || objvalue == "FRANCHISE") {
                            shopform.area.options.add(new Option('N1', 'N1'));
                            shopform.area.options.add(new Option('N2', 'N2'));
                            shopform.area.options.add(new Option('N3', 'N3'));
                            shopform.area.options.add(new Option('C1', 'C1'));
                            shopform.area.options.add(new Option('C2', 'C2'));
                            shopform.area.options.add(new Option('S1', 'S1'));
                            shopform.area.options.add(new Option('S2', 'S2'));

                            switch (cvalue) {
                                case "N1": shopform.area.selectedIndex = 1; break;
                                case "N2": shopform.area.selectedIndex = 2; break;
                                case "N3": shopform.area.selectedIndex = 3; break;
                                case "C1": shopform.area.selectedIndex = 4; break;
                                case "C2": shopform.area.selectedIndex = 5; break;
                                case "S1": shopform.area.selectedIndex = 6; break;
                                case "S2": shopform.area.selectedIndex = 7; break;
                            }
                            if (area.length > 0) {
                                switch (area) {
                                    case "N1": shopform.area.options[1].selected; break;
                                    case "N2": shopform.area.options[2].selected; break;
                                    case "N3": shopform.area.options[3].selected; break;
                                    case "C1": shopform.area.options[4].selected; break;
                                    case "C2": shopform.area.options[5].selected; break;
                                    case "S1": shopform.area.options[6].selected; break;
                                    case "S2": shopform.area.options[7].selected; break;
                                }
                            }
                        }
                        else {
                            shopform.area.options.add(new Option('N', 'N'));
                            shopform.area.options.add(new Option('C', 'C'));
                            shopform.area.options.add(new Option('S', 'S'));
                            switch (cvalue) {
                                case "N": shopform.area.selectedIndex = 1; break;
                                case "C": shopform.area.selectedIndex = 2; break;
                                case "S": shopform.area.selectedIndex = 3; break;
                            }
                            if (area.length > 0) {
                                switch (area) {
                                    case "N": shopform.area.options[1].selected; break;
                                    case "C": shopform.area.options[2].selected; break;
                                    case "S": shopform.area.options[3].selected; break;
                                }
                            }
                        }
                    }
                    break;
                // case "IVR CODE":
                //     var ivr = shopform.store_type.options[shopform.store_type.selectedIndex].value
                //     if (ivr == "RETAIL") {
                //         if (objvalue.length != 4) {

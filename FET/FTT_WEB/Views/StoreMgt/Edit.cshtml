@{
    var funcId = ViewData["FuncId"];
    var mapText = new
    {
        Btn_Create = $"{config.GetMessage("BtnCreate")}",
        Btn_Edit = $"{config.GetMessage("BtnEdit")}",

        Btn_Confirm = config.GetMessage("BtnConfirm"),
        Btn_Cancel = "取消",
    };

    var action = Html.ActionName().ToLower() == "create" ? "create" : "edit";
    var actionName = action == "create" ? mapText.Btn_Create : mapText.Btn_Edit;

    var ivrcode = ViewData["ivrcode"] as string;

    var mapAttr = new
    {
        IdGrid2 = Guid.NewGuid(),
        IdBtnSearch = Guid.NewGuid(),
        IdSearchForm = Guid.NewGuid(),
    };
}

<div class="container-fluid">
    <div class="page-header" style="padding-bottom:20px">
        <div class="row">
            <div class="col-sm-6">
                <h3>門市資料維護</h3>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Home" data-bs-original-title="" title="">首頁</a></li>
                    <li class="breadcrumb-item">後端維護</li>
                    <li class="breadcrumb-item active"><a href="" data-bs-original-title="" title="">門市資料維護</a></li>
                    <li class="breadcrumb-item">編輯</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="card">
        <div class="card-header pb-0">
            <h5>@(actionName.ToHtmlString())</h5>
        </div>
        <div class="card-body card-body-edit">
            <form class="needs-validation" novalidate="" method="post" id="shopform">
                <h4 class="mb-3">門市資料</h4>
                <div class="card">
                    <div class="card-body">
                        <div class="row gx-2 gy-1 smb-5px">
                            <div class=" col-xl-3 col-lg-4 col-md-6 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">公司別</label>
                                <select class="form-control select2-Clear" id="company_leaves" onchange="CheckUserType(this.options[this.selectedIndex].value,'');" required>
                                    <option></option>
                                    @* <option value="1">FET</option> *@
                                </select>
                            </div>

                            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">區域</label>
                                <select class="form-control select2-Clear" id="area" onchange="CheckUserType(this.options[this.selectedIndex].value,'區域');" required>
                                    <option></option>
                                    @*        <option>N1</option>
                                    <option>N2</option> *@
                                </select>
                            </div>

                            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">店格</label>
                                <select class="form-control select2-Clear" id="store_type" onchange="CheckUserType(this.options[this.selectedIndex].value,'店格');" required>
                                    <option></option>
                                    @*              <option>RETAIL</option>
                                    <option>FRANCHISE</option>
                                    <option>MINI FRANCHISE</option>
                                    <option>REGIONAL CENTER</option>
                                    <option>BOOTH</option>
                                    <option>G5</option>
                                    <option>G5S</option> *@
                                </select>
                            </div>

                            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">店名</label>
                                <input type="text" class="form-control" placeholder="" required id="shop_name">
                            </div>

                            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">通路</label>
                                <select class="form-control select2-Clear" id="channel" onchange="CheckUserType(this.options[this.selectedIndex].value,'通路');" required>
                                    <option></option>
                                    @*         <option value="1">RETAIL</option>
                                    <option value="2">FRANCHISE</option> *@
                                </select>
                            </div>

                            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">IVR Code</label>
                                <input type="text" class="form-control" id="ivr_code" placeholder="" required>
                                <div class="invalid-feedback">IVRCODE 應為7碼</div>
                            </div>


                            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">裝潢型態</label>
                                <select class="form-control select2-Clear" id="decoration_condition" onchange="CheckUserType(this.options[this.selectedIndex].value,'裝潢型態');" required>
                                    <option></option>
                                    @* <option value="1">Remodel</option> *@
                                </select>
                            </div>
                            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">驗收日</label>
                                <div class="row align-items-center">
                                    <div class="col-12">
                                        <div class="input-group initDatepicker " id="approval_date" data-target-input="nearest">
                                            <input class="form-control datetimepicker-input" type="text" data-target="#approval_date" required>
                                            <div class="input-group-text" data-target="#approval_date" data-toggle="datetimepicker"><i class="fa fa-calendar-o"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                <label class="col-form-label websoft-form-label pt-2">備註</label>
                                <textarea class="form-control" rows="3" placeholder="" id="note"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <h4 class="mb-3">門市聯絡資料</h4>
                <div class="card">
                    <div class="card-body">
                        <div class="row gx-2 gy-1 smb-5px">


                            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">店長/聯絡人(中文)</label>
                                <input type="text" class="form-control" placeholder="" id="owner_cname" required>
                                <input type="hidden" id="owner_empno" />
                            </div>


                            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                <label class="col-form-label websoft-form-label pt-2">店長/聯絡人(英文)</label>
                                <input type="text" class="form-control" placeholder="" id="owner_ename">
                            </div>


                            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">店長電話</label>
                                <input type="text" pattern="^09\d{2}-?\d{3}-?\d{3}$" title="請輸入有效手機號碼（0912345678 或 0912-345-678）" class="form-control" placeholder="" id="owner_tel" required>
                                <div class="invalid-feedback">請輸入有效手機號碼（0912345678 或 0912-345-678）</div>
                            </div>


                            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">Email</label>
                                <input type="email" class="form-control" placeholder="" id="email" required>
                                <div class="invalid-feedback">請輸入有效手機號碼（0912345678 或 0912-345-678）</div>
                            </div>

                            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">區經理/業務</label>
                                <input type="text" class="form-control" placeholder="" id="as_cname" required>
                                <input type="hidden" id="as_empno" />
                            </div>

                            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">緊急電話</label>
                                <input type="text" class="form-control" placeholder="" id="urgent_tel" pattern="^\d{2,3}-\d{7,}$" title="請輸入市話號碼，例如 02-1234567 或 037-1234567" required>
                                <div class="invalid-feedback">請輸入市話號碼，例如 02-1234567 或 037-1234567</div>
                            </div>

                            <div class="w-100"></div>
                            <div class="col-xl-6 col-lg-7 col-md-8 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">地址</label>
                                <input type="text" class="form-control" id="address" placeholder="" required>
                            </div>

                            <div class="w-100"></div>
                            <div class="col-xl-7 col-lg-8 col-md-10 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">營業時間 (一~五)</label>@* business_hour_range1 *@
                                <div class="row align-items-center">
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <div class="input-group initTimepicker " id="r1" data-target-input="nearest">
                                            <input class="form-control datetimepicker-input" type="text" data-target="#r1" required>
                                            <div class="input-group-text" data-target="#r1" data-toggle="datetimepicker"><i class="fa fa-clock-o"></i></div>
                                            <label class="_custom_middle_label">~</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <div class="input-group initTimepicker " id="r2" data-target-input="nearest">
                                            <input class="form-control datetimepicker-input" type="text" data-target="#r2" required>
                                            <div class="input-group-text" data-target="#r2" data-toggle="datetimepicker"><i class="fa fa-clock-o"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-7 col-lg-8 col-md-10 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">營業時間 (六)</label>
                                <div class="row align-items-center">
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <div class="input-group initTimepicker " id="r3" data-target-input="nearest">
                                            <input class="form-control datetimepicker-input" type="text" data-target="#r3" required>
                                            <div class="input-group-text" data-target="#r3" data-toggle="datetimepicker"><i class="fa fa-clock-o"></i></div>
                                            <label class="_custom_middle_label">~</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <div class="input-group initTimepicker " id="r4" data-target-input="nearest">
                                            <input class="form-control datetimepicker-input" type="text" data-target="#r4" required>
                                            <div class="input-group-text" data-target="#r4" data-toggle="datetimepicker"><i class="fa fa-clock-o"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-7 col-lg-8 col-md-10 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">營業時間 (日)</label>
                                <div class="row align-items-center">
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <div class="input-group initTimepicker " id="r5" data-target-input="nearest">
                                            <input class="form-control datetimepicker-input" type="text" data-target="#r5" required>
                                            <div class="input-group-text" data-target="#r5" data-toggle="datetimepicker"><i class="fa fa-clock-o"></i></div>
                                            <label class="_custom_middle_label">~</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <div class="input-group initTimepicker " id="r6" data-target-input="nearest">
                                            <input class="form-control datetimepicker-input" type="text" data-target="#r6" required>
                                            <div class="input-group-text" data-target="#r6" data-toggle="datetimepicker"><i class="fa fa-clock-o"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-7 col-lg-8 col-md-10 col-12">
                                <label class="col-form-label websoft-form-label pt-2 required">營業時間 (國定假日)</label>
                                <div class="row align-items-center">
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <div class="input-group initTimepicker " id="r7" data-target-input="nearest">
                                            <input class="form-control datetimepicker-input" type="text" data-target="#r7" required>
                                            <div class="input-group-text" data-target="#r7" data-toggle="datetimepicker"><i class="fa fa-clock-o"></i></div>
                                            <label class="_custom_middle_label">~</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <div class="input-group initTimepicker " id="r8" data-target-input="nearest">
                                            <input class="form-control datetimepicker-input" type="text" data-target="#r8" required>
                                            <div class="input-group-text" data-target="#r8" data-toggle="datetimepicker"><i class="fa fa-clock-o"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <button class="btn btn-primary" type="submit" form="shopform">儲存</button>
                <a class="btn btn-info" href="@Url.Action("Index", new { FuncId = funcId, className = ViewData["className"] })">返回</a>

                <div class="modal fade" id="detailModal" tabindex="-1" role="dialog" aria-labelledby="detailModal" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document" style="    min-height: 900px;    max-width: 1080px;">
                        <div class="modal-content" style="    min-height: 900px">
                            <div class="modal-header">
                                <h5 class="modal-title">查詢單位/員工(Search)</h5>
                                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row gx-2 gy-1 smb-5px">
                                    <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                        <label class="col-form-label websoft-form-label pt-2 ">中文名</label>
                                        <input type="text" class="form-control" placeholder="" id="select_empname">
                                    </div>
                                    <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                        <label class="col-form-label websoft-form-label pt-2 ">英文名</label>
                                        <input type="text" class="form-control" placeholder="" id="select_engname">
                                    </div>
                                    <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                        <label class="col-form-label websoft-form-label pt-2 ">員工編號</label>
                                        <input type="text" class="form-control" placeholder="" id="select_empno">
                                    </div>
                                    <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                                        <label class="col-form-label websoft-form-label pt-2 ">部門名稱</label>
                                        <input type="text" class="form-control" placeholder="" id="select_deptname">
                                    </div>
                                    <div class=" col-xl-4 col-lg-6 col-md-12">
                                        <button class="btn btn-secondary" type="button" id="@(mapAttr.IdBtnSearch)">查詢</button>
                                    </div>
                                </div>
                                <div id="@(mapAttr.IdGrid2)"></div>
                                <div class="d-block d-md-flex justify-content-md-end align-items-center pagination">
                                    <div id="pageResizer" class="jsgrid-pager-page">
                                        <span>每頁筆數:</span>
                                        <select id="pageSelect2">
                                        </select>
                                    </div>
                                    <div id="pagers2">
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">關閉</button>
                            </div>
                        </div>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section scripts
{
    <script>
        var dialogType = "";
        var context = {
            $SearchForm: null,

            $Grid2: null,
        }

        function init() {
            context.$SearchForm = $('#@(mapAttr.IdSearchForm)');
            context.$Grid2 = $('#@(mapAttr.IdGrid2)');
        }

        function initGrid2() {
            $("#@(mapAttr.IdGrid2)").jsGrid({
                paging: true,
                width: "100%",
                pageSize: pageDataSource[0].id,
                pageButtonCount: 5,
                pagerFormat: "{first} {prev} {pages} {next} {last}    第 {pageIndex} 頁 共 {pageCount} 頁",
                pagePrevText: "上一頁",
                pageNextText: "下一頁",
                pageFirstText: "第一頁",
                pageLastText: "最後一頁",
                pageLoading: true,
                autoload: true,
                changePageSize: function (pageSize) {
                    var $this = this;
                    $this.pageSize = pageSize;

                    context.$Grid2.jsGrid("openPage", 1);
                    context.$Grid2.jsGrid("loadData");
                },
                pagerContainer: "#pagers2",
                controller: {
                    loadData: function (filter) {
                        var d = $.Deferred();
                        var engname = $('#select_engname').val();
                        var empname = $('#select_empname').val();
                        var empno = $('#select_empno').val();
                        var deptname = $('#select_deptname').val();

                        filter.vm = {
                            engname: engname,
                            empname: empname,
                            empno: empno,
                            deptname: deptname,
                        };
                        $.ajax({
                            type: "POST",
                            url: '@(config.GetBackendUrl() + Url.Action("GetEmpList", "StoreMgt"))',
                            data: filter,
                            dataType: "json",
                            success: function (res) {
                                if (res.Success === false) {
                                    swal({
                                        text: res.Message,
                                        icon: "error",
                                        button: "@mapText.Btn_Confirm.ToHtmlString()"
                                    });
                                    d.reject();
                                    return;
                                }
                                var da = {
                                    data: res.Data,
                                    itemsCount: res.Total
                                }
                                d.resolve(da);
                            }
                        })

                        return d.promise();
                    }

                },
                fields: [
                    {
                        type: 'control', align: "center",
                        width: 130,
                        editButton: false,
                        headerTemplate: (value, item) => {
                            return '操作';
                        },
                        itemTemplate: (value, item) => {
                                    // 建立按鈕
        const selectButton = document.createElement("button");
        selectButton.className = "btn btn-secondary";
        selectButton.textContent = "選擇";

        selectButton.addEventListener("click", () => {
            switch (dialogType) {
                case "AS":
                    document.getElementById("as_cname").value = item["empname"] ?? "";
                    document.getElementById("as_empno").value = item["empno"] ?? "";
                    break;
                default:
                    document.getElementById("owner_empno").value = item["empno"] ?? "";
                    document.getElementById("owner_cname").value = item["empname"] ?? "";
                    document.getElementById("owner_ename").value = item["engname"] ?? "";
                    document.getElementById("owner_tel").value = item["mobile"] ?? "";
                    break;
            }

            // 關閉 modal
            document.querySelectorAll(".btn-close").forEach(btn => btn.click());
        });

        // 建立容器
        const container = document.createElement("div");
        container.appendChild(selectButton);

        return container;

                        }
                    },
                    { name: "empno", type: "text", title: "員工編號", width: 130 },
                    { name: "empname", type: "text", title: "員工姓名", width: 130 },
                    { name: "ext", type: "text", title: "分機號碼", width: 130 },
                    { name: "deptcode", type: "text", title: "部門代號", width: 130 },
                    { name: "deptname", type: "text", title: "部門名稱", width: 130 },
                ]
            });
        }

        $('.initDatepicker').datetimepicker({
            format: 'YYYY/MM/DD',
        });

        $('.initTimepicker').datetimepicker({
            format: 'HH:mm',
        });

        $(".select2-Clear").select2({
            placeholder: "請選擇",
        });

        $('#@(mapAttr.IdBtnSearch)').on('click', (e) => {

            context.$Grid2.jsGrid('search');
        });

        $('#owner_cname').on('click', (e) => {
            $("#detailModal").modal("show");
            dialogType = "";
        });

        $('#as_cname').on('click', (e) => {
            $("#detailModal").modal("show");
            dialogType = "AS";
        });

        function GetSelectContent() {
            showLoader();
            // var data = { formNo: formNo };
            $.ajax({
                type: 'get',
                url: '@(config.GetBackendUrl() + Url.Action("GetSelectContent", "StoreMgt"))',
                // data: data,
                dataType: 'json',
                success: function (data) {
                    if (data.Success == true) {
                        hideLoader();
                        var option;
        select = document.getElementById("company_leaves");

        for (let i = 0; i < data.Data.company_leaves.length; i++) {
            const item = data.Data.company_leaves[i];

            // new Option 自動 escape HTML
            const option = new Option(
                item.Text ?? "",
                item.Value ?? "",
                i === 0,  // selected
                i === 0   // defaultSelected
            );

            // 原生 DOM 插入
            select.add(option);
        }
                 select = document.getElementById("store_type");

        for (let i = 0; i < data.Data.store_types.length; i++) {
            const item = data.Data.store_types[i];

            // new Option 自動 escape HTML
            const option = new Option(
                item.Text ?? "",
                item.Value ?? "",
                i === 0,  // selected
                i === 0   // defaultSelected
            );

            // 原生 DOM 插入
            select.add(option);
        }

        // 原生觸發 change 事件
        select.dispatchEvent(new Event("change"));

                select = document.getElementById("channel");

        for (let i = 0; i < data.Data.channels.length; i++) {
            const item = data.Data.channels[i];

            // new Option 自動 escape HTML
            const option = new Option(
                item.Text ?? "",
                item.Value ?? "",
                i === 0,  // selected
                i === 0   // defaultSelected
            );

            // 原生 DOM 插入
            select.add(option);
        }
                select = document.getElementById("area");

        for (let i = 0; i < data.Data.area.length; i++) {
            const item = data.Data.area[i];

            // new Option 自動 escape HTML
            const option = new Option(
                item.Text ?? "",
                item.Value ?? "",
                i === 0,  // selected
                i === 0   // defaultSelected
            );

            // 安全插入 select
            select.add(option);
        }

                select = document.getElementById("decoration_condition");

        for (let i = 0; i < data.Data.decoration_conditions.length; i++) {
            const item = data.Data.decoration_conditions[i];

            // new Option 自動 escape HTML
            const option = new Option(
                item.Text ?? "",
                item.Value ?? "",
                i === 0,  // selected
                i === 0   // defaultSelected
            );

            // 安全插入 select
            select.add(option);
        }

                        if ('@action' == 'edit') {
                            GetDetail();
                        }
                    } else {
                        alert(data.Message);
                        hideLoader();
                    }
                },
                error: function (msg) {
                    hideLoader();
                }
            });
        };
        function GetDetail() {
            showLoader();
            // var data = { ivrcode: '@ivrcode'};
            $.ajax({
                type: 'get',
                url: '@(config.GetBackendUrl() + Url.Action("GetDetail", "StoreMgt", new { ivrcode = ivrcode }))',
                // data: data,
                dataType: 'json',
                success: function (data) {
                    hideLoader();
                    if (data.Success == true) {

                        var item = data.Data;
                        $('#company_leaves').val(item.company_leaves);
                        $('#store_type').val(item.store_type);

                        $("#store_type option").each(function () {
                            if (item.store_type == 'RETAIL') {
                                if ($(this).val() !== "RETAIL") {
                                    $(this).remove();
                                }
                            }
                            else {

@{
    var mapText = new
    {
        Btn_Search = "查詢",
        Btn_Clear = "清除",
        Btn_Create = "新增",
        Btn_Confirm = "確認",
        Btn_Cancel = "取消",
    };

    var mapUrl = new
    {
        Delete = Url.Action("Delete"),
    };

    var mapAttr = new
    {
        IdBtnSearch = Guid.NewGuid(),
        IdGrid = Guid.NewGuid(),
    };
}

<div class="container-fluid">
    <div class="page-header" style="padding-bottom:20px">
        <div class="row">
            <div class="col-sm-6">
                <h3>門市資料維護</h3>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Home" data-bs-original-title="" title="">首頁</a></li>
                    <li class="breadcrumb-item">功能</li>
                    <li class="breadcrumb-item active"><a href="" data-bs-original-title="" title="">門市資料維護</a></li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card mb-2">
        <div class="card-body py-3 card-body-reduction">
            <div class="row  mb-2">

                <div class="col-xl-3 col-lg-4 col-sm-6 col-12">
                    <label class="col-form-label websoft-form-label pt-2">報修門市</label>
                    <input type="text" class="form-control" placeholder="" id="shop_name">
                </div>

                <div class="col-xl-3 col-lg-4 col-sm-6 col-12">
                    <label class="col-form-label websoft-form-label pt-2">公司別</label>
                    <select class="form-control select2-Clear" id="company_leaves">
                        <option></option>
                    </select>
                </div>


                <div class="col-xl-3 col-lg-4 col-sm-6 col-12">
                    <label class="col-form-label websoft-form-label pt-2">店格</label>
                    <select class="form-control select2-Clear" id="store_type">
                        <option></option>
                    </select>
                </div>

                <div class="col-xl-3 col-lg-4 col-sm-6 col-12">
                    <label class="col-form-label websoft-form-label pt-2">通路</label>
                    <select class="form-control select2-Clear" id="channel">
                        <option></option>
                    </select>
                </div>

                <div class="col-xl-3 col-lg-4 col-sm-6 col-12">
                    <label class="col-form-label websoft-form-label pt-2">區域</label>
                    <select class="form-control select2-Clear" id="area">
                        <option></option>
                    </select>
                </div>

                <div class="col-xl-3 col-lg-4 col-sm-6 col-12">
                    <label class="col-form-label websoft-form-label pt-2">區經理/業務</label>
                    <input type="text" class="form-control" placeholder="" id="as_cname">

                    @*                     <select class="form-control select2-Clear" id="as_cname">
                    <option></option>
                    </select> *@
                </div>

            </div>
            <button class="btn btn-primary" id="@(mapAttr.IdBtnSearch)">送出查詢</button>
            <button class="btn  btn-info" data-bs-toggle="modal" data-bs-target="#areaModal">區域更新</button>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="mb-2">
                <a class="btn btn-primary" href="@(Url.Action("create"))">新增</a>
            </div>
            <div id="@(mapAttr.IdGrid)"></div>
            <div class="d-block d-md-flex justify-content-md-end align-items-center pagination">
                <div id="pageResizer" class="jsgrid-pager-page">
                    <span>每頁筆數:</span>
                    <select id="pageSelect">
                    </select>
                </div>
                <div id="pagers">
                </div>
            </div>
        </div>
    </div>
</div>

@* bootstrap modal for area *@
<div class="modal fade" id="areaModal" tabindex="-1" role="dialog" aria-labelledby="areaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="areaModalLabel">區域更新</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-5">
                    <h5>直營門市</h5>
                    <hr />
                    <span>1. 匯入Sheet請設為"直營門市"</span><br />
                    <span>2. 匯入格式為匯出的檔案格式</span><br />
                    <span>3. 區域/店長員編/區主管員編為必填欄位</span>
                    <input type="file" class="form-control" id="FileRetail" accept=".xlsx, .xls">
                    <button class="btn btn-primary mt-2" type="button" id="btnImportRetail">匯入資料</button>
                    <button class="btn btn-primary mt-2" type="button" id="btnExportRetail">匯出資料</button>
                </div>
                <div class="mt-5">
                    <h5>加盟門市</h5>
                    <hr />
                    <span>1. 匯入Sheet請設為"加盟門市"</span><br />
                    <span>2. 匯入格式為匯出的檔案格式</span><br />
                    <span>3. 區域/業務員編為必填欄位</span>
                    <input type="file" class="form-control" id="FileVass" accept=".xlsx, .xls">
                    <button class="btn btn-primary mt-2" type="button" id="btnImportVass">匯入資料</button>
                    <button class="btn btn-primary mt-2" type="button" id="btnExportVass">匯出資料</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script>

        const context = {
            $Grid: $("#@(mapAttr.IdGrid)"),
        };

        $(function () {
            initGrid(1);

            $("#pageSelect").on("change", function () {
                const val = this.value;
                onPageLenghtSelect(val, context.$Grid);
            })

            $("#pageSelect").select2({
                minimumResultsForSearch: -1,
                data: pageDataSource
            });

            $("#pageSelect").data("select2").$container.addClass("w-auto");

            $('.initDatepicker').datetimepicker({
                format: 'YYYY/MM/DD',
            });

            $(".select2-Clear").select2({
                placeholder: "請選擇",
                allowClear: true,
            });

            $('#@(mapAttr.IdBtnSearch)').on('click', (e) => {
                context.$Grid.jsGrid('search');
            });

            $('#btnImportRetail').on('click', (e) => {
                var file = $("#FileRetail")[0].files[0];
                if (!file) {
                    alert("請選擇檔案");
                    return;
                }

                var fileName = file.name.toLowerCase();
                if (!(fileName.endsWith(".xls") || fileName.endsWith(".xlsx"))) {
                    alert("只能上傳 Excel 檔 (.xls / .xlsx)");
                    return;
                }

                showLoader();

                // 通過才上傳
                var formData = new FormData();
                formData.append("file", file);

                $.ajax({
                    url: '@(config.GetBackendUrl() + Url.Action("ImportRetail", "StoreMgt"))',
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        hideLoader();
                        if (data.Success) {
                            alert(data.Data);
                            $('#File').val('');
                        } else {
                            alert(data.Message);
                            $('#File').val('');
                        }
                    }
                });
            });
            $('#btnExportRetail').on('click', (e) => {
                showLoader();

                $.ajax({
                    url: '@(config.GetBackendUrl() + Url.Action("ExportRetail", "StoreMgt"))',
                    method: 'GET',
                    xhrFields: { responseType: 'blob' },  // 讓回傳是二進位資料
                    success: function (data, status, xhr) {
                        // 從 Content-Disposition 取得檔名
                        var disposition = xhr.getResponseHeader('Content-Disposition');
                        var fileName = "download.xlsx";
                        if (disposition && disposition.indexOf('filename=') !== -1) {
                            var matches = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/.exec(disposition);
                            if (matches != null && matches[1]) {
                                fileName = decodeURIComponent(matches[1].replace(/['"]/g, ''));
                            }
                        }

                        // 建立 Blob 並觸發下載
                        var blob = new Blob([data], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
                        var url = window.URL.createObjectURL(blob);

                        var a = document.createElement("a");
                        a.href = url;
                        a.download = fileName;
                        document.body.appendChild(a);
                        a.click();
                        a.remove();

                        window.URL.revokeObjectURL(url);
                        hideLoader();
                    }
                });
            });

            $('#btnImportVass').on('click', (e) => {
                var file = $("#FileVass")[0].files[0];
                if (!file) {
                    alert("請選擇檔案");
                    return;
                }

                var fileName = file.name.toLowerCase();
                if (!(fileName.endsWith(".xls") || fileName.endsWith(".xlsx"))) {
                    alert("只能上傳 Excel 檔 (.xls / .xlsx)");
                    return;
                }

                showLoader();

                // 通過才上傳
                var formData = new FormData();
                formData.append("file", file);

                $.ajax({
                    url: '@(config.GetBackendUrl() + Url.Action("ImportVass", "StoreMgt"))',
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        hideLoader();
                        if (data.Success) {
                            alert(data.Data);
                            $('#File').val('');
                        } else {
                            alert(data.Message);
                            $('#File').val('');
                        }
                    }
                });
            });
            $('#btnExportVass').on('click', (e) => {
                showLoader();

                $.ajax({
                    url: '@(config.GetBackendUrl() + Url.Action("ExportVass", "StoreMgt"))',
                    method: 'GET',
                    xhrFields: { responseType: 'blob' },  // 讓回傳是二進位資料
                    success: function (data, status, xhr) {
                        // 從 Content-Disposition 取得檔名
                        var disposition = xhr.getResponseHeader('Content-Disposition');
                        var fileName = "download.xlsx";
                        if (disposition && disposition.indexOf('filename=') !== -1) {
                            var matches = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/.exec(disposition);
                            if (matches != null && matches[1]) {
                                fileName = decodeURIComponent(matches[1].replace(/['"]/g, ''));
                            }
                        }

                        // 建立 Blob 並觸發下載
                        var blob = new Blob([data], { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
                        var url = window.URL.createObjectURL(blob);

                        var a = document.createElement("a");
                        a.href = url;
                        a.download = fileName;
                        document.body.appendChild(a);
                        a.click();
                        a.remove();

                        window.URL.revokeObjectURL(url);
                        hideLoader();
                    }
                });
            });

            GetSelectContent();
        });

        function GetSelectContent() {
            showLoader();
            // var data = { formNo: formNo };
            $.ajax({
                type: 'get',
                url: '@(config.GetBackendUrl() + Url.Action("GetSelectContent", "StoreMgt"))',
                // data: data,
                dataType: 'json',
                success: function (data) {
                    if (data.Success == true) {
                        hideLoader();
                        var option;
                        for (var i = 0; i < data.Data.company_leaves.length; i++) {
                            var item = data.Data.company_leaves[i];
                            option = new Option(item.Text, item.Value, false, false);
                            $('#company_leaves').append(option).trigger('change');
                        }
                        for (var i = 0; i < data.Data.store_types.length; i++) {
                            var item = data.Data.store_types[i];
                            option = new Option(item.Text, item.Value, false, false);
                            $('#store_type').append(option).trigger('change');
                        }
                        for (var i = 0; i < data.Data.channels.length; i++) {
                            var item = data.Data.channels[i];
                            option = new Option(item.Text, item.Value, false, false);
                            $('#channel').append(option).trigger('change');
                        }
                        for (var i = 0; i < data.Data.area.length; i++) {
                            var item = data.Data.area[i];
                            option = new Option(item.Text, item.Value, false, false);
                            $('#area').append(option).trigger('change');
                        }
                    } else {
                        alert(data.Message);
                        hideLoader();
                    }
                },
                error: function (msg) {
                    hideLoader();
                }
            });
        };

        function initGrid(cookiePageIndex) {
            $("#@(mapAttr.IdGrid)").jsGrid({
                pageIndex: cookiePageIndex,
                paging: true,
                width: "100%",
                pageSize: pageDataSource[0].id,
                pageButtonCount: 5,
                pagerFormat: "{first} {prev} {pages} {next} {last}    第 {pageIndex} 頁 共 {pageCount} 頁",
                pagePrevText: "上一頁",
                pageNextText: "下一頁",
                pageFirstText: "第一頁",
                pageLastText: "最後一頁",
                pageLoading: true,
                autoload: true,
                changePageSize: function (pageSize) {
                    var $this = this;
                    $this.pageSize = pageSize;

                    context.$Grid.jsGrid("openPage", 1);
                },
                pagerContainer: "#pagers",
                onDataLoaded: function () {
                    feather.replace();
                },
                controller: {
                    loadData: function (filter) {
                        var d = $.Deferred();

                        var shop_name = $('#shop_name').val();
                        var company_leaves = $('#company_leaves').val();
                        var store_type = $('#store_type').val();
                        var channel = $('#channel').val();
                        var area = $('#area').val();
                        var as_cname = $('#as_cname').val();

                        filter.vm = {
                            shop_name: shop_name,
                            company_leaves: company_leaves,
                            store_type: store_type,
                            channel: channel,
                            area: area,
                            as_cname: as_cname,
                        };
                        $.ajax({
                            type: "POST",
                            url: "@(config.GetBackendUrl() + Url.Action("GetPageList"))",
                            data: filter,
                            dataType: "json",
                            success: function (res) {
                                if (res.Success === false) {
                                    swal({
                                        text: res.Message,
                                        icon: "error",
                                        button: "確認"
                                    });
                                    d.reject();
                                    return;
                                }
                                var da = {
                                    data: res.Data,
                                    itemsCount: res.Total
                                }
                                d.resolve(da);
                            }
                        })

                        return d.promise();
                    }
                },
                fields: [
                    { name: "Id", visible: false },
                    {
                        type: 'control', align: "center",
                        width: 80,
                        editButton: false,
                        deleteButton: false,
                        headerTemplate: (value, item) => {
                            return $("<div>操作<div>").attr({ class: '' });
                        },
                        itemTemplate: (value, item) => {

                            $div = $('<div>')

                            $editButton = $('<button>')
                                .attr({
                                    'class': 'exclick jsgrid-button jsgrid-edit-button',
                                })
                                .on('click', () => {
                                    var newTab = window.open('@(Url.Action("Edit", new { ivrcode = "tempid" }))'.replace("tempid", item['ivr_code']), '_blank');
                                });


                            $deleteButton = $('<button>')
                                .attr({
                                    'class': 'exclick jsgrid-button jsgrid-delete-button',
                                })
                                .on('click', () => {
                                    const callDelete = () => {
                                        var data = {
                                            ivr_code: item['ivr_code']
                                        };

                                        $.ajax({
                                            url: '@(config.GetBackendUrl() + mapUrl.Delete.ToHtmlString())',
                                            dataType: 'json',
                                            type: 'POST',
                                            data: data
                                        })
                                            .done((response) => {
                                                var msg = response.Success ? response.Data : response.Message;
                                                var alertType = response.Success ? "success" : "error";

                                                swal({
                                                    text: msg,
                                                    button: '@(mapText.Btn_Confirm.ToHtmlString())',
                                                    icon: alertType
                                                }).then((result) => {
                                                    if (result) {
                                                        context.$Grid.jsGrid('search');
                                                    }
                                                });
                                            });
                                    }

                                    swal({
                                        text: `@config.GetMessage("BeforeDeleteMsg").ToHtmlString()`,
                                        buttons: ['@(mapText.Btn_Cancel.ToHtmlString())', '@(mapText.Btn_Confirm.ToHtmlString())'],
                                        icon: "info"
                                    }).then((result) => {
                                        console.log(result);
                                        if (result) {
                                            callDelete();
                                        }
                                    });
                                });



                            var result = $div.append($editButton).append($deleteButton);

                            return result;
                        }
                    },
                    // 1. 店名 ShopName 2.公司別 Company_Leaves 3.區域 Area 4.店格 store_type 5.通路 Channel  6.Owner_CName 7.區經理/業務 AS_CName
                    { name: "shop_name", title: "店名", type: "text", width: 150, align: "center" },
                    { name: "company_leaves", title: "公司別", type: "text", width: 100, align: "center" },
                    { name: "area", title: "區域", type: "text", width: 100, align: "center" },
                    { name: "store_type", title: "店格", type: "text", width: 120, align: "center" },
                    { name: "channel", title: "通路", type: "text", width: 120, align: "center" },
                    { name: "owner_cname", title: "店長/聯絡人", type: "text", width: 120, align: "center" },
                    { name: "as_cname", title: "區經理/業務", type: "text", width: 120, align: "center" },
                ],

            });

            //分頁頁數紀錄相關
            context.$Grid.jsGrid('_setPage', cookiePageIndex);//jsgrid bug 不會自動將頁碼設定成pageindex
        }

    </script>
}

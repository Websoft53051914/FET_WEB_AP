@{
    var mapData = new
    {
        Grid = new
        {
            Id = Guid.NewGuid().ToString("N"),
            IdPageSelect = Guid.NewGuid().ToString("N"),
            IdPagers = Guid.NewGuid().ToString("N"),
            UrlGetPageList = $"{config.GetBackendUrl()}/DispatchRuleMgt/GetPageList",
        },
        UrlCreate = Url.Action("Create"),
        UrlQuery = Url.Action("Query"),
        UrlEdit = Url.Action("Edit", new { id = "tempId" }),
        UrlDelete = $"{config.GetBackendUrl()}/DispatchRuleMgt/Delete",
    };
}

<style>
    .display-better-multitext {
        max-height: 200px;
        overflow-y: auto;
        display: block;
    }
</style>

<div class="container-fluid">
    <div class="page-header" style="padding-bottom:20px">
        <div class="row">
            <div class="col-sm-6">
                <h3>派工規則維護</h3>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Home" data-bs-original-title="" title="">首頁</a></li>
                    <li class="breadcrumb-item">功能</li>
                    <li class="breadcrumb-item active"><a href="" data-bs-original-title="" title="">派工規則維護</a></li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="card">
        <div class="card-body">
            <div class="d-flex gap-2 mb-2">
                <a class="btn btn-primary" href="@(mapData.UrlCreate?.ToHtmlString())">新增</a>
                <a class="btn btn-primary" href="@(mapData.UrlQuery?.ToHtmlString())" target="_blank">派工規則查詢</a>
            </div>
            <div id="@(mapData.Grid.Id)"></div>
            <div class="d-block d-md-flex justify-content-md-end align-items-center pagination">
                <div id="pageResizer" class="jsgrid-pager-page">
                    <span>每頁筆數:</span>
                    <select id="@(mapData.Grid.IdPageSelect)">
                    </select>
                </div>
                <div id="@(mapData.Grid.IdPagers)">
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script>
        var context = {

        };
        var cookieName = 'DispatchRuleMgtGridInfo';

        $(function () {
            let pageIndex = 1;
            let pageSize = pageDataSource[0].id;
            if (Cookies.get(cookieName)) {
                var cookieObj = JSON.parse(Cookies.get(cookieName));
                if (cookieObj && cookieObj.FromEdit == true) {
                    if (cookieObj.PageIndex) {
                        pageIndex = parseInt(cookieObj.PageIndex);
                    }

                    if (cookieObj.PageSize) {
                        pageSize = parseInt(cookieObj.PageSize);
                    }

                    Cookies.remove(cookieName);
                }
            }
            initGrid(pageIndex, pageSize);
        });
    </script>
    <script>
        function initGrid(cookiePageIndex, cookiePageSize) {
            context['@(mapData.Grid.Id)'] = {};
            var ctxGrid = context['@(mapData.Grid.Id)'];
            ctxGrid.$Grid = $('#@(mapData.Grid.Id)');
            ctxGrid.$Grid.jsGrid({
                pageIndex: cookiePageIndex,
                paging: true,
                pageSize: cookiePageSize,
                pageLoading: true,
                pagerContainer: '#@(mapData.Grid.IdPagers)',
                autoload: true,
                controller: {
                    loadData: function (filter) {
                        var d = $.Deferred();
                        ctxGrid.filter = { ...filter };
                        filter.vm = {};

                        //分頁頁數紀錄相關 紀錄查詢時將查詢條件、頁數 start
                        var cookieobj = {
                            PageIndex: filter.pageIndex,
                            PageSize: filter.pageSize,
                            ...filter.vm
                        };
                        Cookies.set(cookieName, JSON.stringify(cookieobj), { expires: 1 });

                        $.ajax({
                            type: 'POST',
                            url: '@(mapData.Grid.UrlGetPageList?.ToHtmlString())',
                            data: filter,
                            dataType: 'json',
                            success: function (res) {
                                if (res.Success === false) {
                                    MyApp.Alert.error(res.Message)
                                    d.reject();
                                    return;
                                }
                                var da = {
                                    data: res.Data,
                                    itemsCount: res.Total
                                }
                                d.resolve(da);
                            }
                        });

                        return d.promise();
                    }
                },
                fields: [
                    {
                        type: 'control',
                        width: 80,
                        editButton: false,
                        deleteButton: false,

                        headerTemplate: (value, item) => {
                            return $("<div>操作<div>").attr({ class: 'd-flex' });
                        },
                        itemTemplate: (value, item) => {
                                    const safeId = item['@(nameof(DispatchRuleMgtGridVO.Id))'] ?? "";

        // 安全編碼 URL
        const safeEditUrl = '@(mapData.UrlEdit?.ToHtmlString())'.replace('tempId', encodeURIComponent(safeId));

        // 建立 Edit 按鈕
        const btnEdit = document.createElement("a");
        btnEdit.className = 'jsgrid-button jsgrid-edit-button d-inline-block';
        btnEdit.href = safeEditUrl;

        // 建立 Delete 按鈕
        const btnDelete = document.createElement("button");
        btnDelete.className = 'jsgrid-button jsgrid-delete-button d-inline-block';
        btnDelete.type = "button";

        btnDelete.addEventListener("click", () => {
            const callDelete = () => {
                fetch('@(mapData.UrlDelete?.ToHtmlString())', {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ id: safeId })
                })
                .then(response => response.json())
                .then(response => {
                    const safeMsg = response.Message ?? "";

                    if (response.Success) {
                        MyApp.Alert.success('刪除資料成功').then(() => ctxGrid.reload());
                    } else {
                        MyApp.Alert.error(safeMsg).then(() => ctxGrid.reload());
                    }
                })
                .catch(err => console.error(err));
            };

            const safeConfirmMsg = '@(config.GetMessage("BeforeDeleteMsg").ToHtmlString())' ?? "";
            MyApp.Alert.confirm(safeConfirmMsg).then(result => {
                if (result) callDelete();
            });
        });

        // 建立容器
        const result = document.createElement("div");
        result.appendChild(btnEdit);
        result.appendChild(btnDelete);

        return result;

                        }
                    },
                    { name: '@(nameof(DispatchRuleMgtGridVO.Id))', title: '編號', type: 'text', width: 120, align: 'center' },
                    {
                        name: '@(nameof(DispatchRuleMgtGridVO.TIvrCode))', title: 'IVR CODE', type: 'text', width: 200, align: 'center',
                        itemTemplate: (value, item) => {
                            let $content = $('<div>', {
                                class: 'display-better-multitext'
                            }).text(value);

                            return $content;
                        },
                    },
                    {
                        name: '@(nameof(DispatchRuleMgtGridVO.TCisId))', title: '類別ID', type: 'text', width: 200, align: 'center',
                        itemTemplate: (value, item) => {
                            let $content = $('<div>', {
                                class: 'display-better-multitext'
                            }).text(value);

                            return $content;
                        },
                    },
                    {
                        name: '@(nameof(DispatchRuleMgtGridVO.CiName))', title: '類別名稱', type: 'text', width: 250, align: 'center',
                        itemTemplate: (value, item) => {
                            let $content = $('<div>', {
                                class: 'display-better-multitext'
                            }).text(value);

                            return $content;
                        },
                    },
                    { name: '@(nameof(DispatchRuleMgtGridVO.IfWarrant))', title: '保固', type: 'text', width: 120, align: 'center' },
                    {
                        name: '@(nameof(DispatchRuleMgtGridVO.TVender))', title: '廠商ID', type: 'text', width: 120, align: 'center',
                        itemTemplate: (value, item) => {
                            let $content = $('<div>', {
                                class: 'display-better-multitext'
                            }).text(value);

                            return $content;
                        },
                    },
                    {
                        name: '@(nameof(DispatchRuleMgtGridVO.Vender))', title: '廠商名稱', type: 'text', width: 180, align: 'center',
                        itemTemplate: (value, item) => {
                            let $content = $('<div>', {
                                class: 'display-better-multitext'
                            }).text(value);

                            return $content;
                        },
                    },
                    { width: 'auto' }
                ],
            });

            //分頁頁數紀錄相關
            ctxGrid.$Grid.jsGrid('_setPage', cookiePageIndex);//jsgrid bug 不會自動將頁碼設定成pageindex

            $('#@(mapData.Grid.IdPageSelect)').select2({
                minimumResultsForSearch: -1,
                data: pageDataSource
            });
            $('#@(mapData.Grid.IdPageSelect)').data('select2').$container.addClass('w-auto');
            $('#@(mapData.Grid.IdPageSelect)').on('change', (e) => {
                onPageLenghtSelect(e.currentTarget.value, ctxGrid.$Grid);
            });
            ctxGrid.reload = function () {
                ctxGrid.$Grid.jsGrid('search');
            };
        }
    </script>
}
